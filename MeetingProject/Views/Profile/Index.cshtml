@model MeetingProject.Models.Users
@{
    Layout = null; 
}

<div class="modal-header border-0" style="background-color: #343a40; padding: 15px 20px;">
    <h5 class="modal-title fw-bold text-white mb-0"><i class="fas fa-id-badge me-2"></i> Profil Ayarları</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm" style="width: 60px; height: 60px;">
            <i class="fas fa-user" style="font-size: 1.5rem;"></i>
        </div>
        <div class="ms-3">
            <h5 class="fw-bold mb-1">@Model.Name @Model.Surname</h5>
            <span class="badge bg-secondary">@Model.Role</span>
        </div>
    </div>

    <form id="profilForm">
        @Html.AntiForgeryToken()

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Adınız</label>
                <input type="text" name="Name" class="form-control bg-light border-0 shadow-sm" value="@Model.Name" required />
            </div>
            <div class="col-md-6 mt-3 mt-md-0">
                <label class="form-label fw-bold text-muted small">Soyadınız</label>
                <input type="text" name="Surname" class="form-control bg-light border-0 shadow-sm" value="@Model.Surname" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-muted small">E-Posta Adresiniz</label>
            <input type="email" name="Email" class="form-control bg-light border-0 shadow-sm" value="@Model.Email" required />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-muted small">Departman <span class="text-danger fw-normal" style="font-size:0.75rem;">(Değiştirilemez)</span></label>
            <input type="text" class="form-control bg-light border-0 shadow-sm text-muted" value="@Model.Department" readonly disabled />
        </div>

        <div class="text-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                <i class="fas fa-save me-2"></i> Kaydet
            </button>
        </div>
    </form>
</div>

<script>
    $("#profilForm").off("submit").on("submit", function (e) {
        e.preventDefault();
        var btn = $(this).find('button[type="submit"]');
        var originalText = btn.html();
        btn.html('<i class="fas fa-spinner fa-spin me-2"></i> Kaydediliyor...').prop('disabled', true);

        var yeniAd = $('input[name="Name"]').val();
        var yeniSoyad = $('input[name="Surname"]').val();
        var tamIsim = yeniAd + ' ' + yeniSoyad;

        $.ajax({
            url: "/Profile/UpdateProfile",
            type: "POST",
            data: $(this).serialize(),
            success: function (result) {
                btn.html(originalText).prop('disabled', false);
                if (result.success) {

                    $('#genelProfilModali').modal('hide');

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: result.message,
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });

                    $('#sidebar-user-name').text(tamIsim);
                    $('#topbar-user-name').text('Hoş Geldiniz, ' + tamIsim);

                } else {
                    Swal.fire('Hata!', result.message, 'error');
                }
            }
        });
    });
</script>