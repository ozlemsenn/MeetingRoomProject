@{
    Layout = null; 
}

<div class="modal-header border-0" style="background-color: #343a40; padding: 15px 20px;">
    <h5 class="modal-title fw-bold text-warning mb-0"><i class="fas fa-key me-2"></i> Şifre Değiştir</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-4">
    <div class="alert alert-info border-0 shadow-sm" style="font-size: 0.9rem;">
        <i class="fas fa-info-circle me-2"></i> Şifreniz <b>en az 8 karakter</b> uzunluğunda olmalı, <b>en az 1 harf</b> ve <b>1 rakam</b> içermelidir.
    </div>

    <form id="sifreForm">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label fw-bold text-muted small">Mevcut Şifreniz</label>
            <input type="password" name="currentPassword" class="form-control bg-light border-0 shadow-sm" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold text-muted small">Yeni Şifreniz</label>
            <input type="password" name="newPassword" class="form-control bg-light border-0 shadow-sm" required minlength="8" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold text-muted small">Yeni Şifreniz (Tekrar)</label>
            <input type="password" name="confirmPassword" class="form-control bg-light border-0 shadow-sm" required minlength="8" />
        </div>

        <div class="text-end">
            <button type="button" class="btn btn-light me-2" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-warning fw-bold text-dark shadow-sm">
                <i class="fas fa-lock me-2"></i> Şifremi Güncelle
            </button>
        </div>
    </form>
</div>

<script>
    $("#sifreForm").off("submit").on("submit", function (e) {
        e.preventDefault();
        var btn = $(this).find('button[type="submit"]');
        var originalText = btn.html();
        btn.html('<i class="fas fa-spinner fa-spin me-2"></i> Güncelleniyor...').prop('disabled', true);

        $.ajax({
            url: "/Profile/ChangePasswordConfirm",
            type: "POST",
            data: $(this).serialize(),
            success: function (result) {
                btn.html(originalText).prop('disabled', false);
                if (result.success) {

                    $('#genelProfilModali').modal('hide'); 

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: result.message,
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true
                    });

                } else {
                    Swal.fire('Uyarı!', result.message, 'warning');
                }
            }
        });
    });
</script>