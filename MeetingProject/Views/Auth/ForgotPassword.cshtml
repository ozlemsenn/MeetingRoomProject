@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookRoom | Şifremi Unuttum</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .brand-text {
            font-weight: 800;
            font-size: 2.2rem;
            letter-spacing: -1px;
            color: #1e293b;
        }

            .brand-text span {
                background: linear-gradient(to right, #1e3a8a, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .form-control, .input-group-text {
            padding: 14px 18px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            border-radius: 12px;
        }

        .input-group-text {
            border-right: none;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .form-control {
            border-left: none;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

            .form-control:focus {
                box-shadow: none;
                background-color: #fff;
                border-color: #1e3a8a;
            }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: #1e3a8a;
            background-color: #fff;
        }

        .btn-login {
            background: linear-gradient(to right, #1e3a8a, #2563eb);
            border: none;
            border-radius: 12px;
            color: white;
            padding: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(30, 58, 138, 0.25);
        }

            .btn-login:hover {
                box-shadow: 0 15px 25px rgba(30, 58, 138, 0.4);
                transform: translateY(-2px);
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <div class="card login-card p-4 p-md-5">

                    <div class="text-center mb-4 pb-2">
                        <div class="mb-2">
                            <i class="fas fa-unlock-alt fa-3x" style="color: #1e3a8a;"></i>
                        </div>
                        <h2 class="brand-text mb-1">Book<span>Room</span></h2>

                        <div class="mt-3">
                            <h4 class="fw-bold mb-1" style="color: #1e293b;">Şifremi Unuttum</h4>
                            <p class="text-muted" style="font-size: 0.95rem;">Hesabınıza ait e-posta adresini girin.</p>
                        </div>
                    </div>

                    <form action="/Auth/ForgotPassword" method="POST">

                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold mb-1 ms-1">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-at"></i></span>
                                <input type="email" name="Email" class="form-control" placeholder="admin@bookroom.com" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-login w-100 mb-4">
                            Şifremi Sıfırla <i class="fas fa-paper-plane ms-2"></i>
                        </button>

                        <div class="text-center">
                            <a href="/Auth/Login" class="text-decoration-none small fw-semibold text-secondary" style="transition: color 0.3s;" onmouseover="this.style.color='#1e3a8a'" onmouseout="this.style.color='#6c757d'">
                                <i class="fas fa-arrow-left me-1"></i> Giriş Ekranına Dön
                            </a>
                        </div>

                    </form>

                </div>

                <div class="text-center mt-4 text-white opacity-75">
                    <small>© @DateTime.Now.Year BookRoom. Tüm hakları saklıdır.</small>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        @if (ViewBag.Mesaj != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function() {
                var isSuccess = '@ViewBag.Durum' === 'success';

                Swal.fire({
                    title: isSuccess ? 'Başarılı!' : 'Hata!',
                    html: '@Html.Raw(ViewBag.Mesaj)',
                    icon: isSuccess ? 'success' : 'error',
                    confirmButtonText: isSuccess ? 'Tamam' : 'Tekrar Dene',
                    confirmButtonColor: isSuccess ? '#1e3a8a' : '#dc3545'
                });
            });
            </text>
        }
    </script>
</body>
</html>