@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookRoom | Sisteme Giriş</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3); 
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .brand-text {
            font-weight: 800;
            font-size: 2.2rem;
            letter-spacing: -1px;
            color: #1e293b; 
        }

            .brand-text span {
                background: linear-gradient(to right, #1e3a8a, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .form-control, .input-group-text {
            padding: 14px 18px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            border-radius: 12px;
        }

        .input-group-text {
            border-right: none;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .form-control {
            border-left: none;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
            .form-control:focus {
                box-shadow: none;
                background-color: #fff;
                border-color: #1e3a8a;
            }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: #1e3a8a;
            background-color: #fff;
        }

        .btn-login {
            background: linear-gradient(to right, #1e3a8a, #2563eb);
            border: none;
            border-radius: 12px;
            color: white;
            padding: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(30, 58, 138, 0.25);
        }

            .btn-login:hover {
                box-shadow: 0 15px 25px rgba(30, 58, 138, 0.4);
                transform: translateY(-2px);
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <div class="card login-card p-4 p-md-5">

                    <div class="text-center mb-4 pb-2">
                        <div class="mb-2">
                            <i class="fas fa-calendar-check fa-3x" style="color: #1e3a8a;"></i>
                        </div>
                        <h2 class="brand-text mb-1">Book<span>Room</span></h2>

                        <div class="mt-3">
                            <h4 class="fw-bold mb-1" style="color: #1e293b;">Hoş Geldiniz</h4>
                            <p class="text-muted" style="font-size: 0.85rem;">Devam etmek için lütfen hesap bilgilerinizi girin</p>
                        </div>
                    </div>

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger text-center small fw-semibold py-2 rounded-3" role="alert" style="border-left: 4px solid #dc3545;">
                            <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Hata
                        </div>
                    }

                    <form action="/Auth/Login" method="POST">

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold mb-1 ms-1">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-at"></i></span>
                                <input type="email" name="Email" class="form-control" placeholder="admin@bookroom.com" required>
                            </div>
                        </div>

                        <div class="mb-4 pb-1">
                            <label class="form-label text-secondary small fw-bold mb-1 ms-1">Şifre</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-key"></i></span>
                                <input type="password" name="Password" class="form-control" placeholder="••••••••" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-login w-100">
                            Giriş Yap <i class="fas fa-arrow-right ms-2"></i>
                        </button>

                    </form>

                </div>

                <div class="text-center mt-4 text-white opacity-75">
                    <small>© 2026 BookRoom. Tüm hakları saklıdır.</small>
                </div>

            </div>
        </div>
    </div>

</body>
</html>