@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookRoom | Sisteme Giriş</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .brand-text {
            font-weight: 800;
            font-size: 2.2rem;
            letter-spacing: -1px;
            color: #1e293b;
        }

            .brand-text span {
                background: linear-gradient(to right, #1e3a8a, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .form-control, .input-group-text {
            padding: 14px 18px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            border-radius: 12px;
        }

        .input-group-text {
            border-right: none;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .form-control {
            border-left: none;
            border-right: none;
            border-radius: 0;
        }

            .form-control:focus {
                box-shadow: none;
                background-color: #fff;
                border-color: #1e3a8a;
            }

        .password-toggle-btn {
            border-left: none;
            border-top-right-radius: 12px !important;
            border-bottom-right-radius: 12px !important;
            background-color: #f8fafc;
            color: #64748b;
            cursor: pointer;
            transition: all 0.2s;
        }

            .password-toggle-btn:hover {
                color: #1e3a8a;
                background-color: #f1f5f9;
            }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control,
        .input-group:focus-within .password-toggle-btn {
            border-color: #1e3a8a;
            background-color: #fff;
        }

        .btn-login {
            background: linear-gradient(to right, #1e3a8a, #2563eb);
            border: none;
            border-radius: 12px;
            color: white;
            padding: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(30, 58, 138, 0.25);
        }

            .btn-login:hover {
                box-shadow: 0 15px 25px rgba(30, 58, 138, 0.4);
                transform: translateY(-2px);
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">

                <div class="card login-card p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="fas fa-calendar-check fa-3x" style="color: #1e3a8a;"></i>
                        </div>
                        <h2 class="brand-text mb-2">Book<span>Room</span></h2>
                        <h4 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;">Hoş Geldiniz</h4>
                        <p class="text-muted mb-0 px-2" style="font-size: 0.88rem; line-height: 1.5;">Devam etmek için lütfen hesap bilgilerinizi girin</p>
                    </div>

                    <form action="/Auth/Login" method="POST">

                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold mb-1 ms-1">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-at"></i></span>
                                <input type="email" name="Email" class="form-control" placeholder="admin@bookroom.com" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1 px-1">
                                <label class="form-label text-secondary small fw-bold mb-0">Şifre</label>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal" class="text-decoration-none small fw-semibold" style="color: #2563eb;">Şifremi Unuttum?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-key"></i></span>
                                <input type="password" name="Password" id="loginPassword" class="form-control" placeholder="••••••••" required>
                                <button type="button" class="btn input-group-text password-toggle-btn" id="togglePassword" title="Şifreyi Göster/Gizle">
                                    <i class="fas fa-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-login w-100">
                            Giriş Yap <i class="fas fa-arrow-right ms-2"></i>
                        </button>

                    </form>

                </div>

                <div class="text-center mt-4 text-white opacity-75">
                    <small>© @DateTime.Now.Year BookRoom. Tüm hakları saklıdır.</small>
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                <div class="modal-header border-0 pb-0 mt-3 px-4">
                    <h5 class="modal-title fw-bold text-dark"><i class="fas fa-unlock-alt me-2 text-primary"></i> Şifremi Unuttum</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4" style="font-size: 0.95rem;">Hesabınıza ait e-posta adresini girin, şifrenizi geçici olarak sıfırlayalım.</p>

                    <form id="forgotPasswordForm">
                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-bold mb-1 ms-1">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fas fa-at"></i></span>
                                <input type="email" name="ResetEmail" class="form-control bg-light" placeholder="ornek@sirket.com" required style="border-right: 1px solid #e2e8f0; border-top-right-radius: 12px; border-bottom-right-radius: 12px;">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-login w-100 fw-bold">
                            Şifremi Sıfırla <i class="fas fa-paper-plane ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).on("click", "#togglePassword", function () {
            var passwordInput = $("#loginPassword");
            var icon = $("#toggleIcon");

            if (passwordInput.attr("type") === "password") {
                passwordInput.attr("type", "text");
                icon.removeClass("fa-eye").addClass("fa-eye-slash");
            } else {
                passwordInput.attr("type", "password");
                icon.removeClass("fa-eye-slash").addClass("fa-eye");
            }
        });

        @if (ViewBag.Hata != null)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    title: 'Giriş Başarısız!',
                    text: '@Html.Raw(ViewBag.Hata)',
                    icon: 'error',
                    confirmButtonText: 'Tekrar Dene',
                    confirmButtonColor: '#ef4444'
                });
            });
            </text>
        }

        $(document).on("submit", "#forgotPasswordForm", function (e) {
            e.preventDefault();

            var formBtn = $(this).find('button[type="submit"]');
            var originalText = formBtn.html();
            var emailValue = $('input[name="ResetEmail"]').val();

            formBtn.html('<i class="fas fa-spinner fa-spin me-2"></i> İşleniyor...').prop('disabled', true);

            $.ajax({
                url: '/Auth/ForgotPassword',
                type: 'POST',
                data: { Email: emailValue },
                success: function (response) {
                    formBtn.html(originalText).prop('disabled', false);

                    if (response.success) {
                        $('#forgotPasswordModal').modal('hide');
                        $('#forgotPasswordForm')[0].reset();

                        Swal.fire({
                            icon: 'success',
                            title: 'Şifre Sıfırlandı!',
                            html: response.message,
                            confirmButtonText: 'Tamam',
                            confirmButtonColor: '#1e3a8a'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Bulunamadı!',
                            text: response.message,
                            confirmButtonText: 'Tekrar Dene',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                },
                error: function () {
                    formBtn.html(originalText).prop('disabled', false);
                    Swal.fire('Bağlantı Hatası', 'Sunucu ile iletişim kurulamadı.', 'error');
                }
            });
        });
    </script>
</body>
</html>