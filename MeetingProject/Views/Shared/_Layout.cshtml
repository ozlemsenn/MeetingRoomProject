<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BookRoom</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fafc;
            overflow-x: hidden;
        }

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #ffffff;
            box-shadow: 4px 0 20px rgba(0,0,0,0.03);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #e2e8f0;
            overflow-y: auto;
            padding-top: 20px;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background-color: #cbd5e1;
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background-color: transparent;
            }

        .brand-logo {
            font-size: 1.8rem;
            font-weight: 800;
            text-decoration: none;
            color: #333333;
            transition: transform 0.3s ease;
            display: block;
        }

            .brand-logo:hover {
                transform: scale(1.05);
            }

            .brand-logo span {
                background: linear-gradient(to right, #1e3a8a, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .sidebar-link {
            font-weight: 600;
            color: #64748b;
            padding: 12px 20px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            text-decoration: none;
            margin-bottom: 8px;
            transition: all 0.3s ease;
        }

            .sidebar-link:hover, .sidebar-link.active {
                background: #f1f5f9;
                color: #1e3a8a;
                transform: translateX(4px);
            }

            .sidebar-link i {
                width: 25px;
                font-size: 1.2rem;
            }

        .main-wrapper {
            margin-left: 280px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 80px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.01);
            position: relative;
            z-index: 999;
        }

        .content-body {
            padding: 40px;
            flex-grow: 1;
        }
    </style>
</head>
<body>

    <!-- SİDEBAR BAŞLANGICI -->
    <div class="sidebar">
        <a class="brand-logo mb-1 text-center mt-2" href="/">
            <i class="fas fa-calendar-check mb-2" style="color: #1e3a8a; font-size: 2.5rem; display: block;"></i>
            Book<span>Room</span>
        </a>

        <div class="text-center mb-4">
            <small class="text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Toplantı Odası Rezervasyon Sistemi</small>
        </div>

        <hr style="opacity: 0.1; margin: 0 20px;">

        <div class="nav flex-column mt-3 px-3 flex-grow-1">
            <small class="text-muted fw-bold mb-3 ms-2" style="font-size: 0.75rem; letter-spacing: 1px;">MODÜLLER</small>

            <a class="sidebar-link mb-2" href="/Reservations/Index">
                <i class="fas fa-calendar-alt text-primary me-3"></i> Rezervasyonlar
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Yonetici"))
            {
                <a class="sidebar-link mb-2" href="/Rooms/Index">
                    <i class="fas fa-building text-warning me-3"></i> Odalar
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <hr style="opacity: 0.1; margin: 15px 0;">
                <small class="text-muted fw-bold mb-3 ms-2" style="font-size: 0.75rem; letter-spacing: 1px;">YÖNETİM</small>

                <a class="sidebar-link mb-2" href="/Users/Index">
                    <i class="fas fa-users text-success me-3"></i> Kullanıcılar
                </a>
                <a class="sidebar-link mb-2" href="/Admin/Index">
                    <i class="fas fa-chart-pie text-danger me-3"></i> Admin Paneli
                </a>
            }
        </div>

        <!-- SOL ALT: PROFİL VE ÇIKIŞ BUTONU -->
        <div class="mt-auto px-3 pb-4 pt-3 border-top" style="border-color: #e2e8f0 !important; background-color: #fafbfc;">
            <div class="d-flex align-items-center w-100 p-2 rounded-3 bg-white shadow-sm border">

                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2 flex-shrink-0 shadow-sm" style="width: 40px; height: 40px;">
                    <i class="fas fa-user"></i>
                </div>

                <div class="pe-2 text-start flex-grow-1 overflow-hidden">
                    <h6 class="mb-0 fw-bold text-dark text-truncate" style="font-size: 0.85rem;">@Context.Items["UserFullName"]</h6>
                    <small class="text-muted d-block text-truncate" style="font-size: 0.70rem;">
                        @if (User.IsInRole("Admin"))
                        {<text>Sistem Yöneticisi</text> }
                    else if (User.IsInRole("Yonetici"))
                    { <text>Departman Yöneticisi</text> }
                else
                { <text>Personel</text>}
                    </small>
                </div>

                <a href="/Auth/Logout" class="btn btn-light text-danger p-0 shadow-sm rounded-circle d-flex justify-content-center align-items-center flex-shrink-0" style="width: 35px; height: 35px; transition: 0.2s; border: 1px solid #fee2e2;" onmouseover="this.style.background='#dc3545'; this.style.color='#fff'" onmouseout="this.style.background='#fff'; this.style.color='#dc3545'" title="Çıkış Yap">
                    <i class="fas fa-power-off"></i>
                </a>

            </div>
        </div>
    </div>
    <!-- SİDEBAR BİTİŞİ -->
    <!-- ANA İÇERİK (MAIN WRAPPER) BAŞLANGICI -->
    <div class="main-wrapper">

        <!-- ÜST BAR (TOPBAR) -->
        <div class="topbar">
            <div>
                <h4 class="mb-0 fw-bold text-dark">Hoş Geldiniz, @Context.Items["UserFullName"]</h4>
                <small class="text-muted fw-semibold"><i class="far fa-calendar me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")</small>
            </div>

            <!-- SAĞ KISIM: IT Destek Butonu -->
            <a href="mailto:itdestek@sirket.com" class="d-flex align-items-center text-decoration-none bg-white p-2 pe-3 rounded-pill shadow-sm border" style="transition: all 0.2s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#fff'">
                <div class="bg-primary bg-gradient text-white rounded-circle d-flex justify-content-center align-items-center me-2 shadow-sm" style="width: 38px; height: 38px;">
                    <i class="fas fa-headset"></i>
                </div>
                <div class="text-start">
                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.85rem;">IT Destek</h6>
                    <small class="text-muted d-block" style="font-size: 0.70rem; line-height: 1;">Yardım Merkezi</small>
                </div>
            </a>
        </div>

        <!-- DİNAMİK İÇERİK (SAYFALARIN YÜKLENDİĞİ YER) -->
        <div class="content-body">
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="text-center py-4 bg-white mt-auto border-top">
            <p class="text-muted small fw-semibold mb-0">&copy; @DateTime.Now.Year - BookRoom Rezervasyon Yönetim Sistemi</p>
        </footer>

    </div>
    <!-- ANA İÇERİK BİTİŞİ -->
    <!-- SCRİPTLER -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</body>
</html>