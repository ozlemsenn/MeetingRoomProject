<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BookRoom</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fafc;
        }

        .navbar-ozel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(30, 58, 138, 0.08);
            padding: 12px 30px; 
            margin-top: 20px;
            margin-bottom: 40px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.8);
        }

        .menu-link {
            font-weight: 600;
            color: #64748b !important;
            padding: 10px 24px !important; 
            border-radius: 30px;
            transition: all 0.3s ease;
            margin: 0 4px;
            font-size: 1.05rem; 
        }

            .menu-link:hover {
                background: #f1f5f9;
                color: #1e3a8a !important;
                transform: translateY(-2px);
            }

        .menu-aktif {
            background: #1e3a8a;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2);
        }

            .menu-aktif i {
                color: #ffffff !important; 
            }

        .brand-logo {
            font-size: 1.9rem; 
            font-weight: 800;
            letter-spacing: -0.5px;
            text-decoration: none;
            color: #1e293b;
            transition: all .25s ease;
            display: flex;
            align-items: center;
        }

            .brand-logo:hover {
                text-decoration: none;
                transform: scale(1.02);
            }

            .brand-logo span {
                background: linear-gradient(to right, #1e3a8a, #3b82f6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .brand-logo small {
                display: block;
                font-size: 0.8rem; 
                font-weight: 500;
                color: #64748b;
                margin-top: -2px;
            }
    </style>

    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light navbar-ozel">

            <a class="navbar-brand brand-logo" href="/">
                <i class="fas fa-calendar-check me-3" style="color: #1e3a8a; font-size: 2.2rem;"></i> <!-- İkon büyütüldü ve aralık açıldı -->
                <div>
                    Book<span>Room</span>
                    <small>Toplantı Odası Rezervasyon</small>
                </div>
            </a>

            <div class="collapse navbar-collapse d-flex justify-content-end">
                <ul class="navbar-nav" style="flex-direction: row; align-items: center;">
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="/Users/Index">
                            <i class="fas fa-users me-1"></i> Kullanıcılar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-link" href="/Rooms/Index">
                            <i class="fas fa-building me-1"></i> Odalar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link menu-link menu-aktif" href="/Reservations/Index">
                            <i class="fas fa-calendar-alt me-1"></i> Rezervasyonlar
                        </a>
                    </li>
                </ul>
            </div>

        </nav>
    </div>
    </div>

    <div class="container body-content">
        @RenderBody()

        <hr class="mt-5" style="border-top: 1px solid #e2e8f0;" />
        <footer class="text-center py-3">
            <p class="text-muted small fw-semibold">&copy; @DateTime.Now.Year - BookRoom Rezervasyon Yönetim Sistemi</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</body>
</html>