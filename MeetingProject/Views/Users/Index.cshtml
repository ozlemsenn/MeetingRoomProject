@{
    ViewBag.Title = "Kullanıcı Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4" style="margin-top:30px;">
    <div class="row align-items-center mb-4">

        <div class="col-md-7">
            <h2 class="text-primary fw-bold mb-1">
                <i class="fas fa-users-cog me-2"></i> Kullanıcı Yönetimi
            </h2>
            <p class="text-muted mb-0">
                Sistemde kayıtlı kullanıcıları buradan yönetebilir ve yeni kullanıcı ekleyebilirsiniz.
            </p>
        </div>

        <div class="col-md-5">
            <div class="d-flex justify-content-end gap-2 flex-wrap">

                <a href="@Url.Action("ExcelIndir", "Users")"
                   class="btn btn-success shadow-sm"
                   style="border-radius:20px; font-weight:600; padding:10px 22px;">
                    <i class="fas fa-file-excel me-1"></i>
                    Excel İndir
                </a>

                @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
                {
                    <a href="/Users/Create"
                       class="btn btn-primary modal-tetikle shadow-sm"
                       style="border-radius:20px; font-weight:600; padding:10px 22px;">
                        <i class="fas fa-user-plus me-1"></i>
                        Yeni Kullanıcı
                    </a>
                }

            </div>
        </div>

    </div>
</div>

    <div class="row mb-3">
        @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
        {
            <div class="col-md-4 text-start mb-2">
                <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                    <span class="input-group-text bg-white border-0 fw-bold text-muted">
                        <i class="fas fa-building text-primary me-1"></i> Şirket:
                    </span>
                    @Html.DropDownList("sirketFiltre", (SelectList)ViewBag.Companies, "Tüm Şirketler", new { @class = "form-select border-0 text-dark fw-semibold", @id = "sirketFiltre", @style = "cursor: pointer; background-color: #f8f9fa;", onchange = "KullanicilariYukle()" })
                </div>
            </div>
        }

        <div class="col-md-4 text-start mb-2">
            <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                <span class="input-group-text bg-white border-0 fw-bold text-muted">
                    <i class="fas fa-filter text-secondary me-1"></i> Durum:
                </span>
                <select id="durumFiltre" class="form-select border-0 text-dark fw-semibold" style="cursor: pointer; background-color: #f8f9fa;" onchange="KullanicilariYukle()">
                    <option value="Tümü">Tüm Kullanıcılar</option>
                    <option value="Aktif">Sadece Aktif Olanlar</option>
                    <option value="Pasif">Sadece Pasif Olanlar</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="kullaniciTablosu" class="table table-hover table-striped align-middle text-center mb-0">
                    <thead style="background-color: #343a40; color: white;">
                        <tr>
                            <th class="text-center py-3" style="width: 15%;">Ad</th>
                            <th class="text-center py-3" style="width: 15%;">Soyad</th>
                            <th class="text-center py-3" style="width: 20%;">Email</th>
                            <th class="text-center py-3" style="width: 15%;">Departman</th>
                            <th class="text-center py-3" style="width: 15%;">Rol Durumu</th>
                            <th class="text-center py-3" style="width: 20%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="kullaniciListesi">
                        <tr>
                            <td colspan="6" class="text-muted text-center py-5">
                                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>Kullanıcılar yükleniyor...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kullaniciModali" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header border-0" style="background-color: #343a40; padding: 15px 20px; border-radius: 15px 15px 0 0;">
                <h5 id="modalBaslik" class="modal-title fw-bold text-white mb-0">Kullanıcı İşlemi</h5>
                <button type="button" class="btn-close btn-close-white" onclick="$('#kullaniciModali').modal('hide');" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="modalinIci">
                <div class="text-center text-muted p-5">
                    <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i><br>İçerik yükleniyor...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var yetkiliKullaniciMi = '@(ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin ? "true" : "false")' === 'true';
        var girisYapanKisininRolu = '@Session["UserRole"]';

        function KullanicilariYukle() {
            $.ajax({
                url: '/Users/GetUsers?_=' + new Date().getTime(),
                type: 'GET',
                cache: false,
                success: function (data) {

                    if ($.fn.DataTable.isDataTable('#kullaniciTablosu')) {
                        $('#kullaniciTablosu').DataTable().clear().destroy();
                    }

                    var tabloIcerigi = '';
                    var secilenSirket = $('#sirketFiltre').val();
                    var secilenDurum = $('#durumFiltre').val() || "Tümü";

                    $.each(data, function (index, user) {

                        // Şirket Filtresi
                        if (secilenSirket && secilenSirket !== "") {
                            if (String(user.CompanyId) !== String(secilenSirket)) return true;
                        }

                        // Durum Filtresi
                        var gercektenPasifMi = (user.Role === "Pasif" || user.IsActive === false);
                        if (secilenDurum === "Aktif" && gercektenPasifMi) return true;
                        if (secilenDurum === "Pasif" && !gercektenPasifMi) return true;

                        var adGorunumu = user.IsCurrentUser
                            ? '<span class="text-primary fw-bold">' + user.Name + ' (Siz)</span>'
                            : '<span class="fw-bold">' + user.Name + '</span>';

                        var rolMetni = user.Role;
                        if (rolMetni === "Yönetici" || rolMetni === "Yonetici") {
                            rolMetni = "Yönetici";
                        } else if (rolMetni !== "Admin" && rolMetni !== "Pasif") {
                            rolMetni = "Personel";
                        }

                        tabloIcerigi += '<tr>';
                        tabloIcerigi += '<td class="align-middle">' + adGorunumu + '</td>';
                        tabloIcerigi += '<td class="align-middle fw-bold">' + user.Surname + '</td>';
                        tabloIcerigi += '<td class="align-middle"><a href="mailto:' + user.Email + '" class="text-decoration-none text-secondary">' + user.Email + '</a></td>';
                        tabloIcerigi += '<td class="align-middle">' + (user.Department ? user.Department : "-") + '</td>';
                        tabloIcerigi += '<td class="align-middle">' + rolMetni + '</td>';

                        var islemButonlari = '<div class="d-flex justify-content-center align-items-center gap-2">';
                        islemButonlari += '<a href="/Users/Details/' + user.Id + '" class="btn btn-sm text-secondary border-0 shadow-none modal-tetikle p-1" title="Detaylar"><i class="fas fa-eye" style="font-size: 1.15rem;"></i></a>';

                        if (yetkiliKullaniciMi) {
                            islemButonlari += '<a href="/Users/Edit/' + user.Id + '" class="btn btn-sm text-secondary border-0 shadow-none modal-tetikle p-1" title="Düzenle"><i class="fas fa-edit" style="font-size: 1.15rem;"></i></a>';

                            if (user.IsCurrentUser) {
                                islemButonlari += '<button class="btn btn-sm text-muted border-0 shadow-none p-1" title="Kendi Durumunuzu Değiştiremezsiniz" disabled><i class="fas fa-user-shield" style="font-size: 1.15rem;"></i></button>';
                            } else {
                                var isPasif = gercektenPasifMi;

                                if (girisYapanKisininRolu === "Admin") {
                                    if (isPasif) {
                                        islemButonlari += '<a href="/Users/Delete/' + user.Id + '?mode=status" class="btn btn-sm text-success border-0 shadow-none modal-tetikle p-1" title="Aktife Al"><i class="fas fa-user-check" style="font-size: 1.15rem;"></i></a>';
                                    } else {
                                        islemButonlari += '<a href="/Users/Delete/' + user.Id + '?mode=status" class="btn btn-sm text-warning border-0 shadow-none modal-tetikle p-1" title="Pasife Al"><i class="fas fa-user-slash" style="font-size: 1.15rem;"></i></a>';
                                    }
                                    islemButonlari += '<a href="/Users/Delete/' + user.Id + '?mode=delete" class="btn btn-sm text-danger border-0 shadow-none modal-tetikle p-1" title="Kalıcı Sil"><i class="fas fa-trash-alt" style="font-size: 1.15rem;"></i></a>';
                                }
                                else {
                                    if (isPasif) {
                                        islemButonlari += '<a href="/Users/Delete/' + user.Id + '?mode=status" class="btn btn-sm text-success border-0 shadow-none modal-tetikle p-1" title="Aktife Al"><i class="fas fa-user-check" style="font-size: 1.15rem;"></i></a>';
                                    } else {
                                        islemButonlari += '<a href="/Users/Delete/' + user.Id + '?mode=status" class="btn btn-sm text-warning border-0 shadow-none modal-tetikle p-1" title="Pasife Al"><i class="fas fa-user-slash" style="font-size: 1.15rem;"></i></a>';
                                    }
                                }
                            }
                        }
                        islemButonlari += '</div>';

                        tabloIcerigi += '<td class="align-middle text-center text-nowrap">' + islemButonlari + '</td>';
                        tabloIcerigi += '</tr>';
                    });

                    
                    $('#kullaniciListesi').html(tabloIcerigi);

                    $('#kullaniciTablosu').DataTable({
                        "language": {
                            "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json",
                            "emptyTable": "Seçilen kriterlere uygun kullanıcı bulunamadı." 
                        },
                        "order": [[4, "asc"], [0, "asc"]]
                    });
                },
                error: function () {
                    $('#kullaniciListesi').html('<tr><td colspan="6" class="text-center text-danger py-4">Veriler yüklenirken sunucu hatası oluştu.</td></tr>');
                }
            });
        }

        $(document).ready(function () {
            KullanicilariYukle();

            $(document).on('click', '.modal-tetikle', function (Olay) {
                Olay.preventDefault();
                var gidilecekAdres = $(this).attr('href');

                var modalCerceve = $('#kullaniciModali .modal-dialog');
                var modalBaslik = $('#modalBaslik');

                modalBaslik.removeClass('text-primary text-warning text-info text-danger');

                if (gidilecekAdres.indexOf('Create') !== -1) {
                    modalBaslik.text(' Yeni Kullanıcı Ekle').addClass('text-white');
                }
                else if (gidilecekAdres.indexOf('Edit') !== -1) {
                    modalBaslik.text(' Kullanıcıyı Düzenle').addClass('text-white');
                }
                else if (gidilecekAdres.indexOf('Details') !== -1) {
                    modalBaslik.text(' Kullanıcı Detayları').addClass('text-white');
                }
                else if (gidilecekAdres.indexOf('Delete') !== -1) {
                    modalBaslik.text(' Kullanıcı Durum İşlemi').addClass('text-white');
                }

                $('#modalinIci').html('<div class="text-center text-muted p-5"><i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i><br>Yükleniyor...</div>');
                $('#kullaniciModali').modal('show');

                $('#modalinIci').load(gidilecekAdres, function () {
                    if (gidilecekAdres.indexOf('/Users/Edit/') !== -1 ||
                        gidilecekAdres.indexOf('/Users/Delete/') !== -1 ||
                        gidilecekAdres.indexOf('/Users/Details/') !== -1) {

                        var rawId = gidilecekAdres.split('/').pop();
                        var userId = rawId.split('?')[0];

                        $.get('/Users/GetUserData/' + userId, function (kullaniciBilgisi) {
                            if (gidilecekAdres.indexOf('/Users/Edit/') !== -1) {
                                $('#EditId').val(kullaniciBilgisi.Id);
                                $('#EditName').val(kullaniciBilgisi.Name);
                                $('#EditSurname').val(kullaniciBilgisi.Surname);
                                $('#EditEmail').val(kullaniciBilgisi.Email);
                                $('#EditDepartment').val(kullaniciBilgisi.Department);
                            }
                            else if (gidilecekAdres.indexOf('/Users/Delete/') !== -1) {
                                $('#DeleteId').val(kullaniciBilgisi.Id);
                                $('#DeleteFullName').text(kullaniciBilgisi.Name + ' ' + kullaniciBilgisi.Surname);
                                $('#DeleteDepartment').text(kullaniciBilgisi.Department);
                            }
                            else if (gidilecekAdres.indexOf('/Users/Details/') !== -1) {
                                $('#DetailsFullName').text(kullaniciBilgisi.Name + ' ' + kullaniciBilgisi.Surname);
                                $('#DetailsEmail').text(kullaniciBilgisi.Email);
                                $('#DetailsDepartment').text(kullaniciBilgisi.Department);
                            }
                        });
                    }
                });
            });

            $(document).on("submit", "#createForm", function (e) {
                e.preventDefault();
                $.post("/Users/Create", $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#kullaniciModali').modal('hide');
                        KullanicilariYukle();
                        Swal.fire('Başarılı!', result.message || 'Kullanıcı eklendi.', 'success');
                    } else { Swal.fire('Uyarı!', result.message, 'warning'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });

            $(document).on("submit", "#editForm", function (e) {
                e.preventDefault();
                $.post("/Users/Edit", $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#kullaniciModali').modal('hide');
                        KullanicilariYukle();
                        Swal.fire('Başarılı!', 'Kullanıcı bilgileri güncellendi.', 'success');
                    } else { Swal.fire('Uyarı!', result.message, 'warning'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });

            $(document).on("submit", "#deleteForm", function (e) {
                e.preventDefault();
                var silinecekId = $('#DeleteId').val();
                $.post("/Users/Delete/" + silinecekId, $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#kullaniciModali').modal('hide');
                        KullanicilariYukle();
                        Swal.fire({ title: 'İşlem Tamam!', text: 'Kullanıcı durumu başarıyla güncellendi.', icon: 'success', timer: 2000, showConfirmButton: false });
                    } else { Swal.fire('İşlem Başarısız!', result.message, 'error'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });
        });
    </script>
}