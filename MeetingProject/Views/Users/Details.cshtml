@model MeetingProject.Models.Users
@{
    ViewBag.Title = "Details";
    Layout = null;
    string gosterilecekRol = (Model.Role == "Pasif" || string.IsNullOrEmpty(Model.Role)) ? "Personel" : Model.Role;
}

<div class="container-fluid px-2 py-3">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; background-color: #f8f9fa;">
        <div class="card-body p-4 text-center">

            <div class="d-inline-flex align-items-center justify-content-center text-white mb-3 shadow" style="width: 85px; height: 85px; border-radius: 50%; background: linear-gradient(135deg, #0dcaf0 0%, #0dcaf0 100%);">
                <i class="fas fa-user-tie" style="font-size: 2.8rem;"></i>
            </div>

            <h3 class="fw-bold text-dark mb-1">@Model.Name @Model.Surname</h3>

            <div class="mb-4 pb-4 border-bottom">
                <span class="badge bg-secondary shadow-sm px-3 py-2 mt-2" style="font-size: 0.95rem; border-radius: 8px;">
                    @(string.IsNullOrEmpty(Model.Department) ? "Departman Belirtilmemiş" : Model.Department)
                </span>
            </div>

            <div class="row align-items-center justify-content-center mt-2 mb-3">
                <div class="col-sm-5 text-muted fw-bold text-end">
                     Şirket:
                </div>
                <div class="col-sm-7 text-dark fw-semibold text-start" style="font-size: 1.05rem;">
                    @(ViewBag.SirketAdi ?? "Şirket Bilgisi Yok")
                </div>
            </div>

            <div class="row align-items-center justify-content-center mb-3">
                <div class="col-sm-5 text-muted fw-bold text-end">
                     E-Posta Adresi:
                </div>
                <div class="col-sm-7 text-dark fw-semibold text-start" style="font-size: 1.05rem;">
                    @Model.Email
                </div>
            </div>

            <div class="row align-items-center justify-content-center mb-3">
                <div class="col-sm-5 text-muted fw-bold text-end">
                     Sistem Rolü:
                </div>
                <div class="col-sm-7 text-dark fw-semibold text-start" style="font-size: 1.05rem;">
                    @gosterilecekRol
                </div>
            </div>

            <div class="row align-items-center justify-content-center mb-2">
                <div class="col-sm-5 text-muted fw-bold text-end">
                     Hesap Durumu:
                </div>
                <div class="col-sm-7 fw-bold text-start" style="font-size: 1.05rem;">
                    @if (Model.IsActive == true)
                    {
                        <span class="text-success"><i class="fas fa-check-circle me-1"></i> Aktif</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="fas fa-times-circle me-1"></i> Pasif</span>
                    }
                </div>
            </div>

            @if (Model.IsActive == false)
            {
                <div class="row align-items-center justify-content-center mt-3 pt-3 border-top border-light">
                    <div class="col-sm-5 text-muted fw-bold text-end">
                        Pasif Nedeni:
                    </div>
                    <div class="col-sm-7 text-danger fw-semibold text-start fst-italic" style="font-size: 0.95rem;">
                        @(string.IsNullOrEmpty(Model.PassiveReason) ? "Neden belirtilmemiş." : Model.PassiveReason)
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<div class="modal-footer border-0 pt-0 pb-3 justify-content-center">
    <button type="button" class="btn btn-outline-secondary shadow-sm px-5" style="border-radius: 12px; font-weight: 500;" onclick="$('#kullaniciModali').modal('hide');">Kapat</button>
</div>