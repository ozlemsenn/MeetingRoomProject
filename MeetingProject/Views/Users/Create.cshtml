@{
    ViewBag.Title = "Create";
    Layout = null;
}

<form id="createForm">
    @Html.AntiForgeryToken()

    <div class="container-fluid" style="padding: 15px 25px;">
        @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
        {
            <!-- YENİ: id="sirketSecimAlani" eklendi -->
            <div class="row mb-4" id="sirketSecimAlani">
                <div class="col-md-12">
                    <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">
                        <i class="fas fa-building me-1 text-primary"></i>Şirket Seçimi
                    </label>
                    <!-- YENİ: id = "CreateCompanyId" eklendi -->
                    @Html.DropDownList("CompanyId", (SelectList)ViewBag.CompanyId, "Lütfen Şirket Seçiniz...", new { @class = "form-select shadow-sm border-0 bg-light fw-semibold text-dark", required = "required", id = "CreateCompanyId" })
                </div>
            </div>
        }

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">Ad</label>
                <input type="text" id="CreateName" name="Name" class="form-control shadow-sm border-0 bg-light" placeholder="Örn: Ahmet" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">Soyad</label>
                <input type="text" id="CreateSurname" name="Surname" class="form-control shadow-sm border-0 bg-light" placeholder="Örn: Yılmaz" required />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">E-Posta</label>
                <input type="email" id="CreateEmail" name="Email" class="form-control shadow-sm border-0 bg-light" placeholder="Örn: ahmet@sirket.com" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">Departman</label>
                <select id="CreateDepartment" name="Department" class="form-select shadow-sm border-0 bg-light" required>
                    <option value="" selected disabled>Seçiniz...</option>
                    <option value="IT">IT (Bilgi İşlem)</option>
                    <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                    <option value="Pazarlama">Pazarlama</option>
                    <option value="Satış">Satış</option>
                    <option value="Yönetim">Yönetim</option>
                </select>
            </div>
        </div>

        <!-- ROL VE ŞİFRE ALANI -->
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">Sistem Rolü</label>
                <select id="CreateRole" name="Role" class="form-select shadow-sm border-0 bg-light" required>
                    <option value="" selected disabled>Seçiniz...</option>
                    <option value="Personel">Personel</option>
                    <option value="Yönetici">Yönetici</option>
                    @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
                    {
                        <!-- Boş div kaldırıldı, sadece option bırakıldı -->
                        <option value="Admin">Admin (Sistem Yöneticisi)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted" style="font-size: 0.9rem;">Geçici Şifre</label>
                <input type="text" id="CreatePassword" name="Password" class="form-control shadow-sm border-0 bg-light" value="123456" required />
                <small class="text-muted" style="font-size: 0.70rem;">* Kullanıcının ilk giriş şifresi.</small>
            </div>
        </div>

    </div>

    <div class="modal-footer border-0 bg-white d-flex justify-content-end" style="padding: 15px 25px; border-radius: 0 0 10px 10px;">
        <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" style="border-radius: 8px;" onclick="$('#kullaniciModali').modal('hide');">İptal</button>
        <button type="submit" class="btn btn-primary px-4 shadow-sm text-white" style="background-color: #343a40; border-radius: 8px;">Kaydet</button>
    </div>
</form>

<!-- YENİ: JavaScript Animasyon ve Kontrol Kısmı -->
<script>
    $(document).ready(function () {
        // Rol seçimi değiştiğinde tetiklenir
        $('#CreateRole').on('change', function () {
            var secilenRol = $(this).val();

            // Eğer Admin seçildiyse Şirket alanını yukarı doğru kaydırarak (slideUp) gizle ve zorunluluğu kaldır
            if (secilenRol === "Admin") {
                $('#sirketSecimAlani').slideUp(300);
                $('#CreateCompanyId').removeAttr('required');
                $('#CreateCompanyId').val(''); // Önceki seçimi temizle ki veritabanına yanlış veri gitmesin
            }
            // Personel veya Yönetici seçildiyse tekrar göster ve zorunlu yap
            else {
                $('#sirketSecimAlani').slideDown(300);
                $('#CreateCompanyId').attr('required', 'required');
            }
        });
    });
</script>