@{
    ViewBag.Title = "Genel Bakış";
}

<style>
    .fc {
        font-family: inherit;
    }

        .fc .fc-toolbar-title {
            font-size: 1.3rem !important;
            font-weight: 800;
            color: #2b3445;
        }

        .fc .fc-button-primary {
            background: #fff !important;
            color: #495057 !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 8px !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            text-transform: capitalize !important;
            font-weight: 600 !important;
            padding: 6px 12px !important;
            transition: all 0.2s ease;
        }

            .fc .fc-button-primary:hover {
                background: #f8f9fa !important;
            }

        .fc .fc-button-active {
            background: #e2e8f0 !important;
            color: #0f172a !important;
        }

    .fc-theme-standard th {
        border: none !important;
        padding: 12px 0 !important;
        color: #64748b;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .fc-theme-standard td, .fc-theme-standard th {
        border-color: #f1f5f9 !important;
    }

    .fc .fc-daygrid-day-number {
        font-size: 0.9rem;
        font-weight: 600;
        color: #475569;
        padding: 8px;
    }

    .fc-theme-standard .fc-day-today {
        background-color: #f8fafc !important;
    }

    .fc-event {
        border: none !important;
        border-radius: 6px !important;
        padding: 4px 6px !important;
        font-size: 0.80rem !important;
        font-weight: 600 !important;
        cursor: pointer;
        margin-bottom: 3px !important;
    }

    /* Yeni eklenen Timeline Hover efekti */
    .timeline-card:hover {
        background-color: #f8f9fa !important;
        border-color: #dee2e6 !important;
        transform: translateX(3px);
    }
</style>

<div class="container-fluid mt-3">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-dark mb-1">Genel Bakış</h2>
            <p class="text-muted small mb-0">Sistemdeki güncel rezervasyon ve toplantı odası istatistikleri.</p>
        </div>
        <div class="col-md-4 text-end d-flex justify-content-end gap-2">
            <a href="@Url.Action("ExcelIndir", "Admin")" class="btn btn-success shadow-sm fw-bold px-3 py-2" style="border-radius: 8px;">
                <i class="fas fa-file-excel me-1"></i> Rapor İndir
            </a>
            <button class="btn btn-primary shadow-sm fw-bold px-3 py-2" style="border-radius: 8px;" onclick="HizliRezervasyonAc()">
                <i class="fas fa-plus-circle me-1"></i> Yeni Rezervasyon
            </button>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px; background-color: #f0f8ff;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">Toplam Rezervasyon</p>
                        <h3 class="fw-bold text-primary mb-0">@ViewBag.ToplamRezervasyon</h3>
                    </div>
                    <div class="text-primary opacity-50">
                        <i class="fas fa-calendar-check fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px; background-color: #f0fff4;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">Bugünkü Toplantılar</p>
                        <h3 class="fw-bold text-success mb-0">@ViewBag.BugunkuRezervasyon</h3>
                    </div>
                    <div class="text-success opacity-50">
                        <i class="fas fa-clock fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px; background-color: #fffaf0;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">Aktif Odalar</p>
                        <h3 class="fw-bold text-warning mb-0">@ViewBag.ToplamOda</h3>
                    </div>
                    <div class="text-warning opacity-50">
                        <i class="fas fa-door-open fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0" style="border-radius: 12px; background-color: #fff5f5;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold mb-1">İptal Edilenler</p>
                        <h3 class="fw-bold text-danger mb-0">@ViewBag.IptalEdilenler</h3>
                    </div>
                    <div class="text-danger opacity-50">
                        <i class="fas fa-ban fa-3x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8 mb-3">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <div id="rezervasyonTakvimi"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100" style="background-color: #f8f9fa; border-radius: 12px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4">
                        <i class="fas fa-bolt text-success me-2"></i>Bugünün Gündemi
                    </h5>

                    <div class="d-flex flex-column gap-3 mt-2">
                        @if (ViewBag.BugunkuToplantilar != null)
                                    {
                                        var liste = ViewBag.BugunkuToplantilar;
                                        if (liste.Count > 0)
                                        {
                                            foreach (var item in liste)
                                            {
                                                string kenarRengi = "#198754";
                                                string metinRengi = "text-success";
                                                string badgeRengi = "bg-success";
                                                string ikonKodu = "<i class='fas fa-circle me-1' style='font-size: 8px; vertical-align: middle;'></i>";

                                                if (item.Durum == "Devam Ediyor")
                                                {
                                                    kenarRengi = "#0d6efd";
                                                    metinRengi = "text-primary";
                                                    badgeRengi = "bg-primary";
                                                    ikonKodu = "<i class='spinner-grow spinner-grow-sm me-1' style='width: 10px; height: 10px; vertical-align: middle;'></i>";
                                                }
                                                else if (item.Durum == "Tamamlandı")
                                                {
                                                    kenarRengi = "#6c757d";
                                                    metinRengi = "text-secondary";
                                                    badgeRengi = "bg-secondary";
                                                    ikonKodu = "<i class='fas fa-check-circle me-1' style='font-size: 10px; vertical-align: middle;'></i>";
                                                }

                                    <div class="p-3 bg-white shadow-sm"
                                         style="border-radius: 10px; border-left: 5px solid @kenarRengi !important; transition: all 0.3s ease;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="fw-bold text-dark mb-1"><i class="fas fa-door-open text-muted me-1"></i>@item.OdaAdi</h6>
                                                <p class="text-muted small mb-1"><i class="fas fa-quote-left me-1 opacity-50"></i>@item.Baslik</p>
                                                <small class="@metinRengi fw-bold">@Html.Raw(ikonKodu) @item.Durum</small>
                                            </div>
                                            <span class="badge @badgeRengi bg-gradient rounded-pill shadow-sm" style="font-size: 0.90rem; padding: 8px 15px;">
                                                <i class="far fa-clock me-1"></i> @item.Saat
                                            </span>
                                        </div>

                                        <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                            <span class="badge bg-light text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="fas fa-building me-1 opacity-75"></i>@item.SirketAdi
                                            </span>
                                            <span class="badge bg-light text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="fas fa-user me-1 opacity-75"></i>@item.KurucuAdi
                                            </span>
                                            <span class="badge bg-white text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="fas fa-id-badge me-1 opacity-75"></i>@item.KurucuRol
                                            </span>
                                        </div>
                                    </div>
                                            }
                                        }
                                        else
                                        {
                                <div class="text-center text-muted mt-4 p-4 bg-white shadow-sm" style="border-radius: 10px;">
                                    <i class="fas fa-check-circle fa-2x mb-2 text-success opacity-50"></i>
                                    <p class="small fw-semibold mb-0">Harika! Bugün için planlanmış toplantı yok.</p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted mt-4 p-4 bg-white shadow-sm" style="border-radius: 10px;">
                                <p class="small fw-semibold mb-0">Henüz veri yüklenemedi.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row mb-4">

    <!-- GÜNCELLENEN SON HAREKETLER ALANI -->
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-4"><i class="fas fa-history text-secondary me-2"></i>Sistemdeki Son Hareketler</h5>

                <div style="border-left: 2px solid #e9ecef; padding-left: 25px; margin-left: 15px; position: relative;">
                    @if (ViewBag.Aktiviteler != null)
                    {
                        foreach (var aktivite in ViewBag.Aktiviteler)
                        {
                            <div class="mb-4" style="position: relative;">
                                <!-- İkon (Timeline Noktası) -->
                                <div class="rounded-circle d-flex justify-content-center align-items-center shadow-sm"
                                     style="position: absolute; left: -41px; top: 0; width: 32px; height: 32px; background-color: white; border: 2px solid #e9ecef;">
                                    <i class="fas @aktivite.Ikon text-@aktivite.RenkSinifi" style="font-size: 1rem;"></i>
                                </div>

                                <div class="bg-white p-3 rounded-3 shadow-sm border border-light-subtle timeline-card" style="transition: all 0.2s ease;">

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center flex-wrap gap-2">
                                            <span class="fw-bold text-dark" style="font-size: 0.95rem;">
                                                <i class="fas fa-user-circle text-muted me-1"></i>@aktivite.Kullanici
                                            </span>

                                            <span class="badge @(aktivite.Rol == "Admin" ? "bg-danger" : "bg-primary") text-white px-2 py-1" style="font-size: 0.70rem;">
                                                @aktivite.Rol
                                            </span>
                                        </div>
                                        <small class="text-muted fw-bold" style="font-size: 0.75rem; white-space: nowrap;">
                                            <i class="far fa-clock me-1 text-primary"></i>@aktivite.IslemTarihi
                                        </small>
                                    </div>

                                    <div class="mb-2">
                                        <span class="badge bg-light text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="fas fa-building me-1 opacity-75"></i>@aktivite.SirketAdi
                                        </span>
                                    </div>

                                    <p class="mb-0 text-secondary mt-2" style="font-size: 0.90rem;">
                                        @aktivite.Aciklama
                                    </p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small fst-italic p-3 bg-light rounded-3 border border-light-subtle text-center">
                            Henüz sistemde kayıtlı bir hareket bulunmuyor.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0 h-100" style="background-color: #f8f9fa; border-radius: 12px;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-4">
                    <i class="fas fa-list-ul text-warning me-2"></i>Sıradaki Toplantılar
                </h5>

                <div class="d-flex flex-column gap-3 mt-2">
                    @if (ViewBag.SiradakiToplantilar != null)
                    {
                        foreach (var item in ViewBag.SiradakiToplantilar)
                        {
                            <div class="d-flex justify-content-between align-items-center p-3 bg-white shadow-sm"
                                 style="border-radius: 10px; border-left: 5px solid #0d6efd !important;">

                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@item.OdaAdi</h6>
                                    <small class="text-muted fw-semibold">
                                        <i class="far fa-calendar-alt text-primary me-1"></i> @item.Tarih
                                    </small>
                                </div>
                                <span class="badge bg-primary bg-gradient rounded-pill shadow-sm" style="font-size: 0.90rem; padding: 8px 15px;">
                                    <i class="far fa-clock me-1"></i> @item.Saat
                                </span>
                            </div>
                        }

                        if (ViewBag.SiradakiToplantilar.Count == 0)
                        {
                            <div class="text-center text-muted mt-4 p-4 bg-white shadow-sm" style="border-radius: 10px;">
                                <i class="fas fa-mug-hot fa-2x mb-2 text-warning opacity-75"></i>
                                <p class="small fw-semibold mb-0">Yakın zamanda planlanmış toplantı yok.</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="islemModali" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            <div class="modal-header border-0 pb-0" id="modalHeader">
                <h5 class="modal-title fw-bold" id="modalBaslik">Yeni Rezervasyon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="modalIcerik">
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var takvimKutusu = document.getElementById('rezervasyonTakvimi');

        if (!takvimKutusu) return;

        var takvim = new FullCalendar.Calendar(takvimKutusu, {
            initialView: 'dayGridMonth',
            locale: 'tr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek'
            },
            buttonText: { today: 'Bugün', month: 'Ay', week: 'Hafta' },
            height: 500,

            events: '/Admin/GetCalendarEvents',

            eventClick: function (info) {
                var baslik = info.event.title;

                var baslangicSaati = info.event.start ? info.event.start.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '';
                var bitisSaati = info.event.end ? info.event.end.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '...';

                var saat = baslangicSaati + ' - ' + bitisSaati;
                var tarih = info.event.start ? info.event.start.toLocaleDateString('tr-TR') : '';

                var kisi = info.event.extendedProps.kisi;
                var durum = info.event.extendedProps.durum;
                var konu = info.event.extendedProps.konu;
                var katilimcilar = info.event.extendedProps.katilimcilar;
                var renk = info.event.backgroundColor;

                var durumRozeti = durum === 'İptal Edildi' ? 'bg-danger' :
                    (durum === 'Bekliyor' ? 'bg-warning text-dark' :
                        (durum === 'Tamamlandı' ? 'bg-secondary' :
                            (durum === 'Devam Ediyor' ? 'bg-primary' : 'bg-success')));

                var durumYazisi = durum === 'Devam Ediyor' ?
                    '<i class="spinner-grow spinner-grow-sm me-1" style="width: 10px; height: 10px; vertical-align: middle;"></i> Devam Ediyor'
                    : durum;

                var katilimciHtml = '';
                if (katilimcilar !== 'Katılımcı bilgisi yok' && katilimcilar.trim() !== '') {
                    var kisiler = katilimcilar.split(',');
                    kisiler.forEach(function (k) {
                        if (k.trim() !== '') {
                            katilimciHtml += `<span class="badge bg-white text-secondary border border-secondary-subtle me-1 mb-1 fw-normal px-2 py-1 shadow-sm"><i class="fas fa-user-check text-success opacity-75 me-1"></i> ${k.trim()}</span>`;
                        }
                    });
                } else {
                    katilimciHtml = `<span class="text-muted small fst-italic">Kayıtlı katılımcı bulunamadı.</span>`;
                }

                var ozelTasarim = `
                <div class="text-start" style="font-family: inherit;">

                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="rounded-circle d-flex justify-content-center align-items-center text-white shadow-sm" style="width: 55px; height: 55px; background-color: ${renk};">
                            <i class="fas fa-door-open fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h4 class="mb-1 fw-bold text-dark" style="font-size: 1.3rem;">${baslik}</h4>
                            <span class="badge ${durumRozeti} rounded-pill shadow-sm px-3 py-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">${durumYazisi}</span>
                        </div>
                    </div>

                    <div class="mb-3 p-3 rounded-3 bg-light border border-light-subtle">
                        <small class="text-muted d-block mb-1 fw-semibold"><i class="fas fa-quote-left text-primary me-1 opacity-75"></i> Toplantı Konusu</small>
                        <span class="fw-bold text-dark d-block" style="font-size: 0.95rem;">${konu}</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <small class="text-muted d-block mb-1 fw-semibold"><i class="far fa-calendar-alt text-primary me-1 opacity-75"></i> Tarih</small>
                                <span class="fw-bold text-dark fs-6">${tarih}</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <small class="text-muted d-block mb-1 fw-semibold"><i class="far fa-clock text-primary me-1 opacity-75"></i> Saat</small>
                                <span class="fw-bold text-dark fs-6">${saat}</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 p-3 rounded-3 bg-light border border-light-subtle d-flex align-items-center">
                        <div class="bg-white rounded-circle d-flex justify-content-center align-items-center me-3 shadow-sm border" style="width: 40px; height: 40px;">
                            <i class="fas fa-user-tie text-secondary"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block mb-0 fw-semibold" style="font-size: 0.8rem;">Oluşturan / Sahibi</small>
                            <span class="fw-bold text-dark">${kisi}</span>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 bg-light border border-light-subtle">
                        <small class="text-muted d-block mb-2 fw-semibold"><i class="fas fa-users text-primary me-1 opacity-75"></i> Katılımcılar</small>
                        <div class="d-flex flex-wrap">
                            ${katilimciHtml}
                        </div>
                    </div>

                </div>`;

                Swal.fire({
                    html: ozelTasarim,
                    showCloseButton: true,
                    showConfirmButton: false,
                    showCancelButton: true,
                    cancelButtonText: 'Kapat',
                    cancelButtonColor: '#6c757d',
                    width: '500px',
                    padding: '1.5em',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            }
        });

        takvim.render();
    });

    function HizliRezervasyonAc() {
        $('#modalIcerik').html('<div class="p-4 text-center text-muted"><i class="fas fa-spinner fa-spin fa-2x"></i><br>Yükleniyor...</div>');
        $('#modalHeader').removeClass('bg-danger text-white').addClass('text-dark');
        $('#modalBaslik').text("Yeni Rezervasyon Oluştur");
        $('#islemModali').modal('show');

        $.ajax({
            url: '/Reservations/Create',
            type: 'GET',
            success: function (res) { $('#modalIcerik').html(res); },
            error: function () { $('#modalIcerik').html('<div class="p-4 text-center text-danger">Form yüklenirken hata oluştu!</div>'); }
        });
    }
</script>