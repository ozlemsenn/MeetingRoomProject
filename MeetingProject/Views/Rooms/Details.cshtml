@model MeetingProject.Models.Rooms
@{
    ViewBag.Title = "Details";
    Layout = null;

    bool isPasif = Model.Name.Contains("(Pasif)");
    string temizOdaAdi = Model.Name.Replace(" (Pasif)", "");
}

<div class="container-fluid px-2 py-3">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; background-color: #f8f9fa;">
        <div class="card-body p-4 text-center">

            <div class="d-inline-flex align-items-center justify-content-center text-white mb-3 shadow"
                 style="width: 85px; height: 85px; border-radius: 50%; background: linear-gradient(135deg, #6c757d 0%, #343a40 100%);">
                <i class="fas fa-door-open" style="font-size: 2.5rem;"></i>
            </div>

            <h3 class="fw-bold text-dark mb-1">
                @temizOdaAdi
            </h3>

            <div class="mb-4 pb-4 border-bottom">
                <span class="badge bg-secondary shadow-sm px-3 py-2 mt-2"
                      style="font-size: 0.95rem; border-radius: 8px;">
                    <i class="fas fa-users me-1"></i>
                    <span>@Model.Capacity Kişilik Kapasite</span>
                </span>
            </div>

            <div class="row align-items-center justify-content-center mt-2">
                <div class="col-sm-6 text-muted fw-bold text-end">
                    <i class="fas fa-video text-info me-1"></i>
                    Projeksiyon Durumu:
                </div>
                <div class="col-sm-6 text-start fw-semibold" style="font-size:1.05rem;">
                    @if (Model.HasProjector == true)
                    {
                        <span class="text-success"><i class="fas fa-check me-1"></i> Var</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="fas fa-times me-1"></i> Yok</span>
                    }
                </div>
            </div>

            <div class="row align-items-center justify-content-center mt-3">
                <div class="col-sm-6 text-muted fw-bold text-end">
                    <i class="fas fa-toggle-on text-success me-1"></i>
                    Durum:
                </div>
                <div class="col-sm-6 text-start fw-semibold" style="font-size:1.05rem;">
                    @if (isPasif)
                    {
                        <span class="text-danger"><i class="fas fa-times-circle me-1"></i> Pasif</span>
                    }
                    else
                    {
                        <span class="text-success"><i class="fas fa-check-circle me-1"></i> Aktif</span>
                    }
                </div>
            </div>

            @if (isPasif)
            {
                <div class="row align-items-center justify-content-center mt-3 pt-3 border-top border-light">
                    <div class="col-sm-6 text-muted fw-bold text-end">
                        <i class="fas fa-comment-alt text-warning me-1"></i>
                        Pasif Sebebi:
                    </div>
                    <div class="col-sm-6 text-start text-danger fw-semibold fst-italic" style="font-size:1rem;">
                        @(string.IsNullOrEmpty(Model.PassiveReason) ? "Neden belirtilmemiş." : Model.PassiveReason)
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<div class="modal-footer border-0 pt-0 pb-3 justify-content-center">
    <button type="button"
            class="btn btn-outline-secondary shadow-sm px-5"
            style="border-radius:12px;font-weight:500;"
            onclick="$('#odaModali').modal('hide');">
        Kapat
    </button>
</div>