@{
    ViewBag.Title = "Details";
    Layout = null;
}

<div class="container-fluid px-2 py-3">
    <div class="card border-0 shadow-sm" style="border-radius: 15px; background-color: #f8f9fa;">
        <div class="card-body p-4 text-center">

            <div class="d-inline-flex align-items-center justify-content-center text-white mb-3 shadow"
                 style="width: 85px; height: 85px; border-radius: 50%; background: linear-gradient(135deg, #6c757d 0%, #343a40 100%);">
                <i class="fas fa-door-open" style="font-size: 2.5rem;"></i>
            </div>

            <h3 id="DetailsName" class="fw-bold text-dark mb-1">
                Yükleniyor...
            </h3>

            <div class="mb-4 pb-4 border-bottom">
                <span class="badge bg-secondary shadow-sm px-3 py-2 mt-2"
                      style="font-size: 0.95rem; border-radius: 8px;">
                    <i class="fas fa-users me-1"></i>
                    <span id="DetailsCapacity">Yükleniyor...</span>
                </span>
            </div>

            <!-- Projeksiyon -->
            <div class="row align-items-center justify-content-center mt-2">
                <div class="col-sm-6 text-muted fw-bold text-end">
                    <i class="fas fa-video text-info me-1"></i>
                    Projeksiyon Durumu:
                </div>

                <div class="col-sm-6 text-start fw-semibold"
                     id="DetailsHasProjector"
                     style="font-size:1.05rem;">
                    Yükleniyor...
                </div>
            </div>

            <!-- Durum -->
            <div class="row align-items-center justify-content-center mt-3">
                <div class="col-sm-6 text-muted fw-bold text-end">
                    <i class="fas fa-toggle-on text-success me-1"></i>
                    Durum:
                </div>

                <div class="col-sm-6 text-start fw-semibold"
                     id="DetailsStatus"
                     style="font-size:1.05rem;">
                    Yükleniyor...
                </div>
            </div>

            <!-- Pasif Sebebi -->
            <div class="row align-items-center justify-content-center mt-3"
                 id="PassiveReasonRow"
                 style="display:none;">
                <div class="col-sm-6 text-muted fw-bold text-end">
                    <i class="fas fa-comment-alt text-warning me-1"></i>
                    Pasif Sebebi:
                </div>

                <div class="col-sm-6 text-start"
                     id="DetailsPassiveReason"
                     style="font-size:1rem;">
                    -
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal-footer border-0 pt-0 pb-3 justify-content-center">
    <button type="button"
            class="btn btn-outline-secondary shadow-sm px-5"
            style="border-radius:12px;font-weight:500;"
            onclick="$('#odaModali').modal('hide');">
        Kapat
    </button>
</div>