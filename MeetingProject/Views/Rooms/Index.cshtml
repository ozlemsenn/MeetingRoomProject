@{
    ViewBag.Title = "Oda Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4" style="margin-top: 30px;">
    <div class="row align-items-center mb-4">
        <div class="col-md-7">
            <h2 class="text-primary fw-bold mb-1">
                <i class="fas fa-door-open me-2"></i>Toplantı Odaları
            </h2>
            <p class="text-muted mb-0">
                Sistemde kayıtlı toplantı odalarını yönetebilirsiniz.
            </p>
        </div>

        <div class="col-md-5">
            <div class="d-flex justify-content-end gap-2 flex-wrap">

                <a href="@Url.Action("ExcelIndir", "Rooms")"
                   class="btn btn-success shadow-sm"
                   style="border-radius:20px; font-weight:600; padding:10px 22px;">
                    <i class="fas fa-file-excel me-1"></i>
                    Excel İndir
                </a>

                @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
                {
                    <a href="/Rooms/Create"
                       class="btn btn-primary modal-tetikle shadow-sm"
                       style="border-radius:20px; font-weight:600; padding:10px 22px;">
                        <i class="fas fa-plus me-1"></i>
                        Yeni Oda
                    </a>
                }

            </div>
        </div>
    </div>

    <div class="row mb-3">
        @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
        {
            <div class="col-md-4 text-start mb-2">
                <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                    <span class="input-group-text bg-white border-0 fw-bold text-muted">
                        <i class="fas fa-building text-primary me-1"></i> Şirket:
                    </span>
                    @Html.DropDownList("sirketFiltre", (SelectList)ViewBag.Companies, "Tüm Şirketler", new { @class = "form-select border-0 text-dark fw-semibold", @id = "sirketFiltre", @style = "cursor: pointer; background-color: #f8f9fa;", onchange = "OdalariYukle()" })
                </div>
            </div>
        }

        <div class="col-md-4 text-start mb-2">
            <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                <span class="input-group-text bg-white border-0 fw-bold text-muted">
                    <i class="fas fa-filter text-secondary me-1"></i> Durum:
                </span>
                <select id="durumFiltre" class="form-select border-0 text-dark fw-semibold" style="cursor: pointer; background-color: #f8f9fa;" onchange="OdalariYukle()">
                    <option value="Tümü">Tüm Odalar</option>
                    <option value="Aktif">Sadece Aktif Olanlar</option>
                    <option value="Pasif">Sadece Pasif Olanlar</option>
                </select>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="odaTablosu" class="table table-hover table-striped align-middle text-center mb-0">
                    <thead style="background-color: #343a40; color: white;">
                        <tr>
                            <th class="text-center py-3">Oda Adı</th>
                            <th class="text-center py-3">Kapasite</th>
                            <th class="text-center py-3">Projeksiyon</th>
                            <th class="text-center py-3">Durum</th>
                            <th class="text-center py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="odaListesi">
                        <tr>
                            <td colspan="5" class="text-muted text-center py-5">
                                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>Odalar yükleniyor...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="odaModali" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div class="modal-header border-0" style="background-color: #343a40; padding: 15px 20px; border-radius: 15px 15px 0 0;">
                <h5 id="modalBaslik" class="modal-title fw-bold text-white mb-0">Oda İşlemi</h5>
                <button type="button" class="btn-close btn-close-white" onclick="$('#odaModali').modal('hide');" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="modalinIci">
                <div class="text-center text-muted p-5">
                    <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i><br>İçerik yükleniyor...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var yetkiliKullaniciMi = '@(ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin ? "true" : "false")' === 'true';
        var girisYapanKisininRolu = '@Session["UserRole"]';

        function OdalariYukle() {
            $.ajax({
                url: '/Rooms/GetRooms?_=' + new Date().getTime(),
                type: 'GET',
                cache: false,
                success: function (data) {

                    if ($.fn.DataTable.isDataTable('#odaTablosu')) {
                        $('#odaTablosu').DataTable().clear().destroy();
                    }

                    var tabloIcerigi = '';
                    var secilenSirket = $('#sirketFiltre').val();
                    var secilenDurum = $('#durumFiltre').val() || "Tümü";

                    $.each(data, function (index, oda) {

                        if (secilenSirket && secilenSirket !== "") {
                            if (String(oda.companyId) !== String(secilenSirket)) return true;
                        }

                        if (secilenDurum === "Aktif" && oda.Status === "Pasif") return true;
                        if (secilenDurum === "Pasif" && oda.Status === "Aktif") return true;

                        var projeKodu = oda.HasProjector
                            ? '<span style="color:#6c757d;font-weight:600;">Var</span>'
                            : '<span style="color:#6c757d;font-weight:600;">Yok</span>';

                        var durumBadge = oda.Status === "Pasif"
                            ? '<span class="text-danger fw-bold">Pasif</span>'
                            : '<span class="text-success fw-bold">Aktif</span>';

                        tabloIcerigi += '<tr>';
                        tabloIcerigi += '<td class="align-middle fw-bold">' + oda.Name + '</td>';
                        tabloIcerigi += '<td class="align-middle">' + oda.Capacity + ' Kişi</td>';
                        tabloIcerigi += '<td class="align-middle">' + projeKodu + '</td>';
                        tabloIcerigi += '<td class="align-middle">' + durumBadge + '</td>';

                        var islemButonlari = '<div class="d-flex justify-content-center align-items-center gap-2">';
                        islemButonlari += '<a href="/Rooms/Details/' + oda.Id + '" class="btn btn-sm text-secondary border-0 shadow-none modal-tetikle p-1" title="Detaylar"><i class="fas fa-eye" style="font-size: 1.15rem;"></i></a>';

                        if (yetkiliKullaniciMi) {
                            islemButonlari += '<a href="/Rooms/Edit/' + oda.Id + '" class="btn btn-sm text-secondary border-0 shadow-none modal-tetikle p-1" title="Düzenle"><i class="fas fa-edit" style="font-size: 1.15rem;"></i></a>';

                            var isPasif = (oda.Status === "Pasif");

                            if (girisYapanKisininRolu === "Admin") {
                                if (isPasif) {
                                    islemButonlari += '<a href="/Rooms/Delete/' + oda.Id + '?mode=status" class="btn btn-sm text-success border-0 shadow-none modal-tetikle p-1" title="Aktife Al"><i class="fas fa-check-circle" style="font-size: 1.15rem;"></i></a>';
                                } else {
                                    islemButonlari += '<a href="/Rooms/Delete/' + oda.Id + '?mode=status" class="btn btn-sm text-warning border-0 shadow-none modal-tetikle p-1" title="Pasife Al"><i class="fas fa-ban" style="font-size: 1.15rem;"></i></a>';
                                }
                                islemButonlari += '<a href="/Rooms/Delete/' + oda.Id + '?mode=delete" class="btn btn-sm text-danger border-0 shadow-none modal-tetikle p-1" title="Kalıcı Sil"><i class="fas fa-trash-alt" style="font-size: 1.15rem;"></i></a>';
                            }
                            else {
                                if (isPasif) {
                                    islemButonlari += '<a href="/Rooms/Delete/' + oda.Id + '?mode=status" class="btn btn-sm text-success border-0 shadow-none modal-tetikle p-1" title="Aktife Al"><i class="fas fa-check-circle" style="font-size: 1.15rem;"></i></a>';
                                } else {
                                    islemButonlari += '<a href="/Rooms/Delete/' + oda.Id + '?mode=status" class="btn btn-sm text-warning border-0 shadow-none modal-tetikle p-1" title="Pasife Al"><i class="fas fa-ban" style="font-size: 1.15rem;"></i></a>';
                                }
                            }
                        }
                        islemButonlari += '</div>';

                        tabloIcerigi += '<td class="align-middle text-center">' + islemButonlari + '</td>';
                        tabloIcerigi += '</tr>';
                    });

                    if (tabloIcerigi === '') {
                        tabloIcerigi = '<tr><td colspan="5" class="text-center text-muted py-4">Kriterlere uygun oda bulunamadı.</td></tr>';
                    }

                    $('#odaListesi').html(tabloIcerigi);

                    $('#odaTablosu').DataTable({
                        "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                        "order": [[3, "asc"], [0, "asc"]] 
                    });
                },
                error: function () {
                    $('#odaListesi').html('<tr><td colspan="5" class="text-center text-danger py-4">Sunucu hatası oluştu.</td></tr>');
                }
            });
        }

        $(document).ready(function () {
            OdalariYukle();

            $(document).on('click', '.modal-tetikle', function (Olay) {
                Olay.preventDefault();
                var gidilecekAdres = $(this).attr('href');

                var modalCerceve = $('#odaModali .modal-dialog');
                var modalBaslik = $('#modalBaslik');

                if (gidilecekAdres.indexOf('Create') !== -1) modalBaslik.text(' Yeni Oda Ekle');
                else if (gidilecekAdres.indexOf('Edit') !== -1) modalBaslik.text(' Odayı Düzenle');
                else if (gidilecekAdres.indexOf('Details') !== -1) modalBaslik.text(' Oda Detayları');
                else if (gidilecekAdres.indexOf('Delete') !== -1) modalBaslik.text(' Oda Durum İşlemi');

                var rawId = gidilecekAdres.split('/').pop();
                var roomId = rawId.split('?')[0];

                $('#modalinIci').html('<div class="text-center text-muted p-5"><i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i><br>Yükleniyor...</div>');
                $('#odaModali').modal('show');

                $('#modalinIci').load(gidilecekAdres, function () {
                    if (gidilecekAdres.indexOf('/Rooms/Delete/') !== -1 || gidilecekAdres.indexOf('/Rooms/Details/') !== -1 || gidilecekAdres.indexOf('/Rooms/Edit/') !== -1) {
                        var roomId = gidilecekAdres.split('/').pop();
                        $.get('/Rooms/GetRoomData/' + roomId, function (odaBilgisi) {
                            if (odaBilgisi) {

                                var temizOdaAdi = odaBilgisi.Name.replace(" (Pasif)", "");

                                $('#DeleteId').val(odaBilgisi.Id);
                                $('#DeleteName, #DetailsName').text(temizOdaAdi);
                                $('#DeleteCapacity, #DetailsCapacity').text("Kapasite: " + odaBilgisi.Capacity + " Kişi");

                                $('#EditId').val(odaBilgisi.Id);
                                $('#EditName').val(temizOdaAdi);
                                $('#EditCapacity').val(odaBilgisi.Capacity);

                                $('#DetailsHasProjector').html(
                                    odaBilgisi.HasProjector
                                        ? '<span class="text-secondary fw-bold">Var</span>'
                                        : '<span class="text-secondary fw-bold">Yok</span>'
                                );

                                if (odaBilgisi.Status === "Aktif") {

                                    $('#DetailsStatus').html('<span class="text-success fw-bold">Aktif</span>');
                                    $('#PassiveReasonRow').hide();

                                } else {

                                    $('#DetailsStatus').html('<span class="text-danger fw-bold">Pasif</span>');
                                    $('#DetailsPassiveReason').text(odaBilgisi.PassiveReason || "-");
                                    $('#PassiveReasonRow').show();

                                }
                            }
                        });
                    }
                });
            });

            $(document).on("submit", "#createForm", function (e) {
                e.preventDefault();
                $.post("/Rooms/Create", $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#odaModali').modal('hide'); OdalariYukle(); Swal.fire('Başarılı!', 'Oda eklendi.', 'success');
                    } else { Swal.fire('Uyarı!', result.message, 'warning'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });

            $(document).on("submit", "#editForm", function (e) {
                e.preventDefault();
                $.post("/Rooms/Edit", $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#odaModali').modal('hide'); OdalariYukle(); Swal.fire('Başarılı!', 'Oda güncellendi.', 'success');
                    } else { Swal.fire('Uyarı!', result.message, 'warning'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });

            $(document).on("submit", "#deleteForm", function (e) {
                e.preventDefault();
                var silinecekId = $('#DeleteId').val();
                $.post("/Rooms/Delete/" + silinecekId, $(this).serialize(), function (result) {
                    if (result.success) {
                        $('#odaModali').modal('hide'); OdalariYukle(); Swal.fire({ title: 'İşlem Tamam!', text: 'Oda durumu güncellendi.', icon: 'success', timer: 2000, showConfirmButton: false });
                    } else { Swal.fire('İşlem Başarısız!', result.message, 'error'); }
                }).fail(function(){ Swal.fire('Hata!', 'Sunucu bağlantı hatası.', 'error'); });
            });
        });
    </script>
}