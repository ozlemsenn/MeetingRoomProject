@{
    Layout = null;
}

<div class="modal-body p-0">
    <div class="container-fluid px-4 py-3">
        <div id="hataMesajiAlani" class="alert alert-danger d-none shadow-sm" style="border-radius: 8px; font-size: 0.9rem; padding: 10px;"></div>

        <form id="formRezervasyon">
            @Html.AntiForgeryToken()

            @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
            {
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold mb-1">Rezervasyon Yapılacak Şirket</label>
                        @Html.DropDownList("CompanyId", (SelectList)ViewBag.Companies, "Lütfen Şirket Seçiniz", new { @class = "form-select shadow-sm border-0 bg-light", @id = "sirketSecimi", @required = "required" })
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" name="CompanyId" value="@Session["CompanyId"]" />
            }

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Toplantı Odası</label>
                    @Html.DropDownList("RoomId", (SelectList)ViewBag.Rooms, "Oda Seçiniz", new { @class = "form-select shadow-sm border-0 bg-light", @required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Kuran Kişi</label>
                    @Html.DropDownList("UserId", (SelectList)ViewBag.Users, "Kullanıcı Seçiniz", new { @class = "form-select shadow-sm border-0 bg-light", @required = "required", id = "UserId" })
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1">Toplantı Başlığı</label>
                    <input type="text" name="Title" class="form-control shadow-sm border-0 bg-light" placeholder="Örn: 2026 Q3 Finansal Değerlendirme" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Tarih</label>
                    <input type="date" name="Date" id="tarihInput" class="form-control shadow-sm border-0 bg-light" required>
                </div>
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Başlangıç</label>
                    <input type="time" name="StartTime" class="form-control shadow-sm border-0 bg-light" required />
                </div>
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Bitiş</label>
                    <input type="time" name="EndTime" class="form-control shadow-sm border-0 bg-light" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1">Katılımcılar</label>
                    <div class="dropdown">
                        <button class="form-select shadow-sm border-0 bg-light text-start" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <span id="secilenKisiSayisi">Katılımcı Seçiniz...</span>
                        </button>
                        <ul class="dropdown-menu w-100 shadow border-0 p-2" aria-labelledby="dropdownMenuButton" style="max-height: 200px; overflow-y: auto;">
                            <div id="katilimciCheckboxListesi">
                                @foreach (var item in (SelectList)ViewBag.KullaniciListesi)
                                {
                                    <div class="px-2 py-1">
                                        <label class="d-flex align-items-center" style="cursor:pointer">
                                            <input type="checkbox" name="SecilenKatilimcilar" value="@item.Value" class="me-2 katilimci-chk">
                                            @item.Text
                                        </label>
                                    </div>
                                }
                            </div>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1">Açıklama / Amacı</label>
                    <textarea name="Description" class="form-control shadow-sm border-0 bg-light" rows="3" style="resize: none;" placeholder="Örn: Bütçe değerlendirmesi..." required></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal-footer border-0 bg-white d-flex justify-content-between align-items-center" style="padding: 15px 20px; border-radius: 0 0 15px 15px;">
    <button type="button" id="btnDolulukGoster" class="btn btn-info text-white shadow-sm d-none" style="border-radius: 8px; padding: 8px 15px;" onclick="DolulukDurumunuGetir()">
        <i class="fas fa-calendar-alt me-2"></i> Doluluk Durumu
    </button>
    <div>
        <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" style="border-radius: 8px;" onclick="$('#islemModali').modal('hide');">İptal</button>
        <button type="button" class="btn px-4 shadow-sm fw-bold text-white" style="background-color: #343a40; border-radius: 8px;" onclick="Kaydet()">Oluştur</button>
    </div>
</div>

<script>
    $(document).ready(function () {
        var today = new Date().toISOString().split('T')[0];
        $('#tarihInput').attr('min', today).val(today);

        var guncelKullaniciListesi = [];

        function listeyiHazirla() {
            guncelKullaniciListesi = [];
            $('#katilimciCheckboxListesi input:checkbox').each(function () {
                var val = $(this).val();
                var text = $(this).parent().text().trim();
                guncelKullaniciListesi.push({ Id: val, TamAd: text });
            });
        }
        listeyiHazirla();

        $('#sirketSecimi').change(function () {
            var secilenSirketId = $(this).val();
            if (!secilenSirketId) return;

            $.ajax({
                url: '/Reservations/SirketeGoreVerileriGetir',
                type: 'GET',
                data: { sirketId: secilenSirketId },
                success: function (data) {
                    guncelKullaniciListesi = data.kullanicilar;

                    var odaDropdown = $('select[name="RoomId"]').empty().append('<option value="">Oda Seçiniz</option>');
                    $.each(data.odalar, function (i, oda) { odaDropdown.append('<option value="' + oda.Id + '">' + oda.Name + '</option>'); });

                    var kullaniciDropdown = $('select[name="UserId"]').empty().append('<option value="">Kullanıcı Seçiniz</option>');
                    $.each(guncelKullaniciListesi, function (i, kullanici) { kullaniciDropdown.append('<option value="' + kullanici.Id + '">' + kullanici.TamAd + '</option>'); });

                    renderKatilimcilar(null);
                }
            });
        });

        $('#UserId').change(function () {
            renderKatilimcilar($(this).val());
        });

        function renderKatilimcilar(kuranKisiId) {
            var container = $('#katilimciCheckboxListesi').empty();
            $.each(guncelKullaniciListesi, function (i, kullanici) {
                if (String(kullanici.Id) !== String(kuranKisiId)) {
                    container.append(`
                        <div class="px-2 py-1">
                            <label class="d-flex align-items-center" style="cursor:pointer">
                                <input type="checkbox" name="SecilenKatilimcilar" value="${kullanici.Id}" class="me-2 katilimci-chk">
                                ${kullanici.TamAd}
                            </label>
                        </div>
                    `);
                }
            });
            $('#secilenKisiSayisi').text('Katılımcı Seçiniz...');
        }

        $(document).on('change', '.katilimci-chk', function () {
            var sayi = $('.katilimci-chk:checked').length;
            $('#secilenKisiSayisi').text(sayi > 0 ? sayi + " kişi seçildi" : "Katılımcı Seçiniz...");
        });
    });
</script>