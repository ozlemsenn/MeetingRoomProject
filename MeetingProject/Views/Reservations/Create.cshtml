@{
    Layout = null;
}

<div class="modal-body p-0">
    <div class="container-fluid px-4 py-3">

        <div id="hataMesajiAlani" class="alert alert-danger d-none shadow-sm" style="border-radius: 8px; font-size: 0.9rem; padding: 10px;"></div>

        <form id="formRezervasyon">
            @Html.AntiForgeryToken()

            <!-- 1. ODA VE KULLANICI -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1">Toplantı Odası</label>
                    @Html.DropDownList("RoomId", (SelectList)ViewBag.Rooms, "Oda Seçiniz", new { @class = "form-select shadow-sm border-0 bg-light", @required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small fw-bold mb-1 d-flex align-items-center">
                        Kuran Kişi
                        <i class="fas fa-info-circle ms-2 text-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Arama yapabilirsiniz" style="cursor: help; font-size: 0.9rem;"></i>
                    </label>
                    @Html.DropDownList("UserId", (SelectList)ViewBag.Users, "Kullanıcı Seçiniz", new { @class = "form-select shadow-sm border-0 bg-light select2-kullanici", @required = "required", style = "width: 100%;" })
                </div>
            </div>

            <!-- 2. TOPLANTI BAŞLIĞI (col-12 yapıldı, tam satır uzayacak) -->
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1">Toplantı Başlığı</label>
                    <input type="text" name="Title" class="form-control shadow-sm border-0 bg-light" style="width: 100% !important; max-width: 100% !important;" placeholder="Örn: 2026 Q3 Finansal Değerlendirme" required />
                </div>
            </div>

            <!-- 3. TARİH VE SAATLER (Aynı row içine alındı, yan yana duracaklar) -->
            <div class="row mb-3">
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Tarih</label>
                    <input type="date" name="Date" id="tarihInput" class="form-control shadow-sm border-0 bg-light" required onchange="TarihSecildi()">
                </div>
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Başlangıç</label>
                    <input type="time" name="StartTime" class="form-control shadow-sm border-0 bg-light" required />
                </div>
                <div class="col-4">
                    <label class="form-label text-muted small fw-bold mb-1">Bitiş</label>
                    <input type="time" name="EndTime" class="form-control shadow-sm border-0 bg-light" required />
                </div>
            </div>

            <!-- 4. KATILIMCILAR -->
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1><span class="fw-normal">Katılımcılar (Birden fazla seçebilirsiniz)</span></label> 
                    @Html.ListBox("SecilenKatilimcilar", (SelectList)ViewBag.KullaniciListesi,
                        new { @class = "form-control shadow-sm border-0 bg-light select2-multiple", multiple = "multiple", style = "width: 100%;" })
                </div>
            </div>

            <!-- 5. AÇIKLAMA -->
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label text-muted small fw-bold mb-1">Açıklama / Amacı</label>
                    <textarea name="Description" class="form-control shadow-sm border-0 bg-light" rows="3" style="width: 100% !important; max-width: 100% !important; resize: none;" placeholder="Örn: Bütçe değerlendirmesi..." required></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal-footer border-0 bg-white d-flex justify-content-between align-items-center" style="padding: 15px 20px; border-radius: 0 0 15px 15px;">

    <button type="button" id="btnDolulukGoster" class="btn btn-info text-white shadow-sm d-none" style="border-radius: 8px; padding: 8px 15px;" onclick="DolulukDurumunuGetir()">
        <i class="fas fa-calendar-alt me-2"></i> Doluluk Durumu
    </button>

    <div>
        <button type="button" class="btn btn-outline-secondary px-4 shadow-sm" style="border-radius: 8px;" onclick="$('#islemModali').modal('hide');">İptal</button>
        <button type="button" class="btn px-4 shadow-sm fw-bold text-white" style="background-color: #343a40; border-radius: 8px;" onclick="Kaydet()">Oluştur</button>
    </div>
</div>

<div id="dolulukAlani" class="px-4 pb-3" style="display:none;">
    <div class="card border-0 bg-light shadow-sm">
        <div class="card-body" id="dolulukIcerik">
        </div>
    </div>
</div>

<style>
    /* --- 1. AÇILIR LİSTEDEKİ YEŞİL TİK GÖRÜNÜMÜ --- */
    .select2-results__option[aria-selected="true"] {
        background-color: #f1f5f9 !important;
        color: #1e3a8a !important;
        position: relative;
        padding-right: 30px !important;
    }

        .select2-results__option[aria-selected="true"]::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #10b981;
            font-size: 1.1rem;
        }

    /* --- 2. SEÇİLEN KİŞİLERİN LACİVERT KUTUCUK (TAG) GÖRÜNÜMÜ --- */
    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #1e3a8a !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 6px !important;
        padding: 5px 12px !important;
        margin-top: 6px !important;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: #ffffff !important;
        margin-right: 10px !important;
        border-right: 1px solid rgba(255, 255, 255, 0.3) !important;
        padding-right: 8px !important;
    }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
            background: transparent !important;
            color: #ff4d4d !important; /* Çarpı işaretinin üzerine gelince kırmızı olur */
        }

    /* Çoklu seçim kutusunun genel yüksekliği ve arkaplanı */
    .select2-container .select2-selection--multiple {
        min-height: 45px !important;
        border: 0px !important;
        background-color: #f8f9fa !important;
        padding-bottom: 5px;
    }
</style>

<!-- DİKKAT: bloğunu sildik, script direkt çalışacak -->
<script>
    $(document).ready(function () {

        // Tekli Kullanıcı Seçici
        $('.select2-kullanici').select2({
            dropdownParent: $('#islemModali'),
            placeholder: "Kullanıcı Ara...",
            allowClear: true
        });

        // ÇOKLU KATILIMCI SEÇİCİ (Lacivert kutucuklu yapıyı çalıştırır)
        $('.select2-multiple').select2({
            dropdownParent: $('#islemModali'),
            placeholder: "Toplantıya katılacak kişileri seçin...",
            allowClear: true,
            width: '100%'
        });

    });
</script>