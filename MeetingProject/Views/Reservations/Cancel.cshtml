@model MeetingProject.Models.Reservations
@{
    Layout = null;

    var katilimcilar = Model.Attendees;
    var katilimciListesi = !string.IsNullOrEmpty(katilimcilar) && katilimcilar != "Katılımcı yok" ? katilimcilar.Split(',') : new string[0];
}

<div class="container-fluid px-2 py-3 text-center">

    <p class="text-secondary fw-semibold mb-4" style="font-size: 1.05rem;">
        Bu rezervasyonu iptal etmek istediğinize emin misiniz? <br />
        <span class="text-muted small" style="font-weight: normal;">Bu işlem geri alınamaz ve toplantı odası başkaları için uygun hale gelir.</span>
    </p>

    <div class="card border-danger shadow-sm mx-auto mb-4" style="border-radius: 12px; background-color: #fff5f5; max-width: 420px; text-align: left;">
        <div class="card-body p-3">

            <h5 class="fw-bold text-dark mb-2">
                <i class="fas fa-door-open text-danger me-2"></i> @ViewBag.OdaAdi
            </h5>

            <div class="text-dark fw-bold mb-2" style="font-size: 1.05rem;">
                @Model.Title
            </div>

            <hr class="text-danger opacity-25 my-2">

            <div class="text-muted small fw-bold mb-3">
                <i class="far fa-calendar-alt me-1"></i> @(Model.Date.HasValue ? Model.Date.Value.ToString("dd.MM.yyyy") : "Tarih Belirtilmedi")
                <span class="mx-2">|</span>
                <i class="far fa-clock me-1"></i> @(Model.StartTime.HasValue ? Model.StartTime.Value.ToString(@"hh\:mm") : "") - @(Model.EndTime.HasValue ? Model.EndTime.Value.ToString(@"hh\:mm") : "")
            </div>

            @if (katilimciListesi.Length > 0)
            {
                <div class="small fw-bold text-muted mb-1">Katılımcılar:</div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var kisi in katilimciListesi)
                    {
                        <span class="badge" style="background-color: #fce4e4; color: #b71c1c; border: 1px solid #f5c6cb; font-size: 0.75rem;">
                            @kisi.Trim()
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    <form id="formIptal" class="px-2 text-start">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-2">
            <label class="form-label text-muted small fw-bold mb-1">İptal Nedeni (İsteğe Bağlı)</label>
            <textarea name="CancelReason" class="form-control shadow-sm border-0 bg-light" style="width: 100% !important; max-width: 100% !important; resize: none;" rows="3" placeholder="Neden iptal ediyorsunuz?"></textarea>
        </div>
    </form>
</div>

<div class="modal-footer border-0 pt-0 pb-3 justify-content-center">
    <button type="button" class="btn btn-outline-secondary shadow-sm px-4" style="border-radius: 8px;" onclick="$('#islemModali').modal('hide');">Vazgeç</button>
    <button type="button" class="btn btn-danger shadow-sm px-4 fw-bold" style="border-radius: 8px;" onclick="IptalOnayla()">Evet, İptal Et</button>
</div>