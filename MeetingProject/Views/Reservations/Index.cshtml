@{
    ViewBag.Title = "Rezervasyonlar";
}

<style>
    #rezervasyonTablosu tbody tr td {
        padding-top: 17px !important;
        padding-bottom: 17px !important;
        border-bottom: 1px solid #f1f5f9;
    }

    .table-striped > tbody > tr:nth-of-type(odd) > * {
        background-color: #f8fafc !important;
        box-shadow: inset 0 0 0 9999px rgba(0, 0, 0, 0.01) !important;
    }

    .table-hover > tbody > tr:hover > * {
        background-color: #f1f5f9 !important;
        transition: all 0.2s ease-in-out;
    }
</style>

<div class="row mb-4" style="margin-top: 20px;">
    <div class="col-md-8">
        <h2 class="text-primary fw-bold">Rezervasyon Yönetimi</h2>
        <p class="text-muted">Toplantı odalarının doluluk durumunu ve rezervasyonları yönetebilirsiniz.</p>
    </div>
    <div class="col-md-4" style="display: flex; justify-content: flex-end; align-items: center;">
        <button class="btn btn-primary shadow-sm" style="border-radius: 20px; font-weight: 600; padding: 10px 20px;" onclick="ModalAc('/Reservations/Create')">
            + Yeni Rezervasyon
        </button>
    </div>
</div>

<div class="card shadow-sm" style="border-radius: 15px; border: none;">
    <div class="card-body">
        <div class="row mb-4 mt-2">

            @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
            {
                <div class="col-md-4 text-start mb-2">
                    <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                        <span class="input-group-text bg-white border-0 fw-bold text-muted" style="padding-right: 5px;">
                            <i class="fas fa-building text-primary me-1"></i> Şirket:
                        </span>
                        @Html.DropDownList("sirketFiltre", (SelectList)ViewBag.Companies, "Tüm Şirketler", new { @class = "form-select border-0 text-dark fw-semibold", @id = "sirketFiltre", @style = "cursor: pointer; background-color: #f8f9fa;", onchange = "TabloyuDoldur()" })
                    </div>
                </div>
            }

            <div class="col-md-4 text-start mb-2">
                <div class="input-group shadow-sm" style="border-radius: 12px; overflow: hidden; border: 1px solid #ced4da;">
                    <span class="input-group-text bg-white border-0 fw-bold text-muted" style="padding-right: 5px;">
                        <i class="fas fa-filter text-secondary me-1"></i> Durum:
                    </span>
                    <select id="rezervasyonFiltre" class="form-select border-0 text-dark fw-semibold" style="cursor: pointer; background-color: #f8f9fa;" onchange="TabloyuDoldur()">
                        <option value="Tümü">Tüm Rezervasyonlar</option>
                        <option value="Planlandı">Sadece Planlananlar</option>
                        <option value="Devam Ediyor">Şu An Devam Edenler</option>
                        <option value="Tamamlandı">Geçmiş Toplantılar</option>
                        <option value="İptal Edildi">İptal Edilenler</option>
                    </select>
                </div>
            </div>

            <div class="col-md-4 text-end align-self-center">
            </div>

        </div>

        <table id="rezervasyonTablosu" class="table table-striped table-hover table-borderless align-middle">
            <thead class="thead-dark" style="background-color: #343a40; color: white;">
                <tr>
                    <th class="text-center align-middle" style="width: 10%;">Tarih</th>
                    <th class="text-center align-middle" style="width: 10%;">Saat Aralığı</th>
                    <th class="text-center align-middle" style="width: 20%;">Oda</th>
                    <th class="text-center align-middle" style="width: 20%;">Kuran Kişi</th>
                    <th class="text-center align-middle" style="width: 30%;">Başlık</th>
                    <th class="text-center align-middle" style="width: 10%;">Durum</th>
                    <th class="text-center align-middle" style="width: 15%;">İşlemler</th>
                </tr>
            </thead>
            <tbody id="rezervasyonListesi">
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="islemModali" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">

            <div class="modal-header border-0" style="background-color: #343a40; padding: 15px 20px; border-radius: 15px 15px 0 0;">
                <h5 id="modalBaslik" class="modal-title fw-bold text-white mb-0">Rezervasyon İşlemi</h5>
                <button type="button" class="btn-close btn-close-white" onclick="$('#islemModali').modal('hide');" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="modalIcerik" style="padding: 0;">
            </div>

        </div>
    </div>
</div>

@section scripts {
    <!-- SweetAlert2 (Şık Uyarı Mesajları İçin) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            TabloyuDoldur();
        });

        function SiralamaTarihiOlustur(tarihStr, saatStr) {
            if (!tarihStr) return "000000000000";
            var parcalar = tarihStr.split('.');
            var formatliTarih = tarihStr;
            if (parcalar.length === 3) formatliTarih = parcalar[2] + parcalar[1] + parcalar[0];
            else formatliTarih = tarihStr.replace(/-/g, '');
            var formatliSaat = (saatStr || "").replace(/:/g, '').padEnd(4, '0');
            return formatliTarih + formatliSaat;
        }

        function TabloyuDoldur() {
            $.ajax({
                url: '/Reservations/GetReservations?_=' + new Date().getTime(),
                type: 'GET',
                cache: false,
                success: function (data) {

                    if ($.fn.DataTable.isDataTable('#rezervasyonTablosu')) {
                        $('#rezervasyonTablosu').DataTable().clear().destroy();
                    }

                    var html = '';
                    var secilenFiltre = $('#rezervasyonFiltre').val() || "Tümü";
                    var secilenSirket = $('#sirketFiltre').val();

                    $.each(data, function (i, item) {

                        var gercekDurum = item.Durum || item.Status;
                        if (secilenFiltre !== "Tümü" && gercekDurum !== secilenFiltre && item.Status !== secilenFiltre) return true;
                        if (secilenSirket && secilenSirket !== "" && String(item.CompanyId) !== String(secilenSirket)) return true;

                        var siralamaDegeri = SiralamaTarihiOlustur(item.Date, item.StartTime);

                        html += '<tr>';
                        html += '<td data-order="' + siralamaDegeri + '" class="text-center align-middle"><strong>' + item.Date + '</strong></td>';
                        html += '<td class="text-center align-middle"><span class="badge bg-light text-dark">' + item.StartTime + ' - ' + item.EndTime + '</span></td>';
                        html += '<td class="text-center align-middle">' + item.RoomName + '</td>';
                        html += '<td class="text-center align-middle">' + item.UserName + '</td>';

                        var kisaBaslik = item.Title;
                        if (kisaBaslik && kisaBaslik.length > 30) kisaBaslik = kisaBaslik.substring(0, 30) + '...';
                        html += '<td class="align-middle fw-medium text-dark">' + (kisaBaslik || '-') + '</td>';

                        var badgeRengi = "bg-success";
                        var ikonKodu = "";

                        if (gercekDurum === "Devam Ediyor") {
                            badgeRengi = "bg-primary";
                            ikonKodu = "<i class='spinner-grow spinner-grow-sm me-1' style='width: 10px; height: 10px; vertical-align: middle;'></i> ";
                        }
                        else if (gercekDurum === "Tamamlandı") badgeRengi = "bg-secondary";
                        else if (gercekDurum === "İptal Edildi" || item.Status === "İptal Edildi") {
                            badgeRengi = "bg-danger";
                            gercekDurum = "İptal Edildi";
                        }
                        else if (gercekDurum === "Bekliyor" || item.Status === "Bekliyor") {
                            badgeRengi = "bg-warning text-dark";
                            gercekDurum = "Bekliyor";
                        }

                        html += '<td class="text-center align-middle"><span class="badge ' + badgeRengi + ' shadow-sm px-3 py-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">' + ikonKodu + gercekDurum + '</span></td>';

                        html += '<td class="align-middle text-center">';
                        html += '<div class="d-flex justify-content-center align-items-center flex-nowrap gap-1">';
                        html += '<button class="btn btn-sm text-secondary border-0 shadow-none" title="Detayları Gör" onclick="ModalAc(\'/Reservations/Details/' + item.Id + '\')"><i class="fas fa-eye" style="font-size: 1.1rem;"></i></button>';

                        if (gercekDurum !== 'İptal Edildi' && gercekDurum !== 'Tamamlandı') {

                            // --- YENİ KİLİT MANTIĞI BURADA ÇALIŞIYOR ---
                            if (item.IsLocked) {
                                // Toplantıya 1 saatten az kaldıysa butonları gizle, gri bir kilit ikonu çıkar
                                html += '<button class="btn btn-sm text-muted border-0 shadow-none" title="Toplantıya 1 saatten az kaldığı için kilitlendi" style="cursor:not-allowed;" disabled><i class="fas fa-lock" style="font-size: 1.1rem;"></i></button>';
                            }
                            else {
                                // Vakit varsa düzenle/iptal butonları serbest
                                html += '<button class="btn btn-sm text-secondary border-0 shadow-none" title="Düzenle" onclick="ModalAc(\'/Reservations/Edit/' + item.Id + '\')"><i class="fas fa-edit" style="font-size: 1.1rem;"></i></button>';
                                html += '<button class="btn btn-sm text-secondary border-0 shadow-none" title="İptal Et" onclick="ModalAc(\'/Reservations/Cancel/' + item.Id + '\')"><i class="fas fa-ban" style="font-size: 1.1rem;"></i></button>';
                            }
                        }

                        // Silme butonu sadece Adminlere gözüktüğü için bırakıyoruz
                        html += '<button class="btn btn-sm text-secondary border-0 shadow-none" title="Tamamen Sil" onclick="ModalAc(\'/Reservations/Delete/' + item.Id + '\')"><i class="fas fa-trash-alt" style="font-size: 1.1rem;"></i></button>';
                        html += '</div></td></tr>';
                    });

                    $('#rezervasyonListesi').html(html);
                    $('#rezervasyonTablosu').DataTable({
                        "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                        "order": [[0, "desc"]]
                    });
                }
            });
        }

        function ModalAc(url) {
            // (Modal Açma mantığın tamamen aynı, dokunmadım)
            var modalCerceve = $('#islemModali .modal-dialog');
            var modalBaslik = $('#modalBaslik');
            modalBaslik.removeClass('text-primary text-warning text-info text-danger text-white text-light');

            if (url.indexOf('Create') !== -1) { modalBaslik.text(' Yeni Rezervasyon Ekle').addClass('text-white'); modalCerceve.removeClass('modal-lg'); }
            else if (url.indexOf('Edit') !== -1) { modalBaslik.text(' Rezervasyonu Düzenle').addClass('text-white'); modalCerceve.removeClass('modal-lg'); }
            else if (url.indexOf('Details') !== -1) { modalBaslik.text(' Rezervasyon Detayları').addClass('text-white'); modalCerceve.removeClass('modal-lg'); }
            else if (url.indexOf('Delete') !== -1) { modalBaslik.text(' Rezervasyonu Kalıcı Olarak Sil').addClass('text-white'); modalCerceve.removeClass('modal-lg'); }
            else if (url.indexOf('Cancel') !== -1) { modalBaslik.text(' Rezervasyonu İptal Et').addClass('text-white'); modalCerceve.removeClass('modal-lg'); }
            else { modalBaslik.text('Rezervasyon İşlemi').addClass('text-white'); }

            $.get(url).done(function (data) {
                $('#modalIcerik').html(data);
                $('#islemModali').modal('show');
            }).fail(function () {
                $('#modalIcerik').html("<div class='alert alert-danger text-center m-4 p-4' style='border-radius:15px;'><i class='fas fa-ban fa-3x mb-3 text-danger'></i><br><h5 class='fw-bold'>Yetkisiz İşlem!</h5><p class='mb-0'>Sadece kendi oluşturduğunuz rezervasyonlara müdahale edebilirsiniz.</p></div>");
                $('#islemModali').modal('show');
            });
        }

        // --- KAYDET, SİL, GÜNCELLE ve İPTAL fonksiyonları aynen duruyor ---
        function Kaydet() {
            var formData = $('#formRezervasyon').serialize();
            $('#hataMesajiAlani').addClass('d-none');
            $.post('/Reservations/Create', formData, function (response) {
                if (response.success) {
                    $('#islemModali').modal('hide'); TabloyuDoldur(); Swal.fire('Başarılı!', 'Rezervasyon eklendi.', 'success');
                } else {
                    $('#hataMesajiAlani').removeClass('d-none').html('<strong>⚠️ Uyarı:</strong> ' + response.message);
                }
            }).fail(function () { $('#hataMesajiAlani').removeClass('d-none').html('<strong>❌ Sunucu Hatası:</strong> İşlem tamamlanamadı.'); });
        }

        function Sil() {
            var formData = $('#formSil').serialize();
            $.post('/Reservations/Delete', formData, function (response) {
                if (response.success) {
                    $('#islemModali').modal('hide'); TabloyuDoldur(); Swal.fire({ title: 'Silindi!', icon: 'success', timer: 2000, showConfirmButton: false });
                } else { Swal.fire('Yetkisiz İşlem!', response.message, 'error'); }
            });
        }

        function Guncelle() {
            var formData = $('#formDuzenle').serialize();
            $('#hataMesajiAlaniDuzenle').addClass('d-none');
            $.post('/Reservations/Edit', formData, function (response) {
                if (response.success) {
                    $('#islemModali').modal('hide'); TabloyuDoldur(); Swal.fire('Başarılı!', 'Rezervasyon güncellendi.', 'success');
                } else {
                    $('#hataMesajiAlaniDuzenle').removeClass('d-none').html('<strong> Uyarı:</strong> ' + response.message);
                }
            });
        }

        function IptalOnayla() {
            var formData = $('#formIptal').serialize();
            $.post('/Reservations/CancelConfirm', formData, function (response) {
                if (response.success) {
                    $('#islemModali').modal('hide'); TabloyuDoldur(); Swal.fire({ title: 'İptal Edildi!', icon: 'success', timer: 2000, showConfirmButton: false });
                } else { Swal.fire('Uyarı!', response.message, 'warning'); }
            });
        }
    </script>
}